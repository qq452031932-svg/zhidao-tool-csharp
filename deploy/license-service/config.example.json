{
  "listen_address": "127.0.0.1:18092",
  "license_database_path": "/var/lib/superpan-license/state.db",
  "encryption_key_path": "/etc/superpan-license/encryption.key",
  "previous_encryption_key_paths": [],
  "lookup_hmac_key_path": "/etc/superpan-license/lookup.key",
  "signing_private_key_path": "/etc/superpan-license/response-signing.key",
  "internal_secret_path": "/etc/superpan-license/admin.secret",
  "load_test_enabled": false,
  "load_test_secret_path": "",
  "signing_key_id": "replace-with-generated-key-id",
  "public_api_base_path": "/license-api/v1",
  "limits": {
    "max_body_bytes": 65536, "max_header_bytes": 16384, "timestamp_window_seconds": 300,
    "nonce_lifetime_seconds": 600, "max_replay_nonces": 131072, "max_admin_idempotency_entries": 1024,
    "max_admin_idempotency_bytes": 10485760, "activation_requests": 30, "validation_requests": 60,
    "admin_requests": 120, "rate_window_seconds": 60, "read_header_timeout_seconds": 5,
    "read_timeout_seconds": 15, "write_timeout_seconds": 15, "idle_timeout_seconds": 60,
    "shutdown_timeout_seconds": 30
  }
}

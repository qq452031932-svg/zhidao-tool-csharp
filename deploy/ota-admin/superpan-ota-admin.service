[Unit]
Description=SuperPan OTA administration service
After=network.target
After=var-lib-otaadmin-releases.mount
Requires=var-lib-otaadmin-releases.mount

[Service]
Type=simple
User=superpan-ota-admin
Group=superpan-ota-admin
SupplementaryGroups=superpan-license-admin
UMask=0077
ExecStartPre=/bin/sh -ec 'actual=$$(id -Gn | tr " " "\n" | LC_ALL=C sort | tr "\n" " "); test "$$actual" = "superpan-license-admin superpan-ota-admin "'
WorkingDirectory=/var/lib/superpan-ota-admin
ExecStart=/opt/superpan-ota-admin/ota-admin serve --config /etc/superpan-ota-admin/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

# All directives below are supported by the systemd v219 shipped by CentOS 7.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
# The release tree is made available through a separate bind-mount unit. This
# avoids the nested path exceptions that old systemd mount namespaces reject.
InaccessibleDirectories=/www/wwwroot
ReadWriteDirectories=/var/lib/superpan-ota-admin
ReadWriteDirectories=/var/lib/otaadmin/releases
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

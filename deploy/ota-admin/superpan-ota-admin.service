[Unit]
Description=SuperPan OTA administration service
After=network.target

[Service]
Type=simple
User=superpan-ota-admin
Group=superpan-ota-admin
UMask=0027
WorkingDirectory=/var/lib/superpan-ota-admin
ExecStart=/opt/superpan-ota-admin/ota-admin serve --config /etc/superpan-ota-admin/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

# All directives below are supported by the systemd v219 shipped by CentOS 7.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
# Hide every existing web root from the service, then expose only the OTA
# release directory it is allowed to publish. Both directives exist in v219.
InaccessibleDirectories=/www/wwwroot
ReadWriteDirectories=/var/lib/superpan-ota-admin
ReadWriteDirectories=/www/wwwroot/ota.fanfh.cn/releases/win-x64
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

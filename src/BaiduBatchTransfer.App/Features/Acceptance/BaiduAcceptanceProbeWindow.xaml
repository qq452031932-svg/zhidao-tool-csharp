<Window x:Class="BaiduBatchTransfer.App.Features.Acceptance.BaiduAcceptanceProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="百度现场验收（仅开发调试）"
        Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F5F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="现场验收模式" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,7,0,0" Foreground="#52677B" TextWrapping="Wrap"
                           Text="请只使用无敏感内容的测试文件。你亲自完成一次转存和分享；程序仅提取官方接口的结构，不保存请求头、请求正文、响应值、账号信息、文件 ID、Cookie、分享链接或提取码。" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="16" Background="White" BorderBrush="#DCE5EF" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#24445F"
                           Text="正在准备安全验收窗口……" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="关闭（不保存）" MinWidth="116" Click="OnCancel" />
                    <Button Content="保存脱敏证据并关闭" MinWidth="168" Margin="10,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

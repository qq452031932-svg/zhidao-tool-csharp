<Window x:Class="BaiduBatchTransfer.App.Features.BrowserAutomation.WebAutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="百度网页操作"
        Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F5F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="百度网页操作" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="软件一次只处理一个账号。需要验证时，请直接在下方可见页面中完成。"
                           Margin="0,7,0,0" Foreground="#52677B" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="16" Background="White" BorderBrush="#DCE5EF" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#24445F"
                           Text="正在准备可见浏览器……" TextWrapping="Wrap"
                           AutomationProperties.Name="网页操作状态"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel x:Name="HandoffActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="已处理，继续" MinWidth="116" Click="OnResume"
                            AutomationProperties.Name="已处理，继续" />
                    <Button Content="跳过此项" MinWidth="106" Margin="10,0,0,0" Click="OnSkip"
                            AutomationProperties.Name="跳过此项" />
                    <Button Content="取消批次" MinWidth="106" Margin="10,0,0,0" Click="OnCancelBatch"
                            AutomationProperties.Name="取消批次" />
                </StackPanel>
                <StackPanel x:Name="PickerActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="确认选择" MinWidth="106" Click="OnConfirmSelection"
                            AutomationProperties.Name="确认选择" />
                    <Button Content="取消选择" MinWidth="106" Margin="10,0,0,0" Click="OnCancelSelection"
                            AutomationProperties.Name="取消选择" />
                </StackPanel>
                <StackPanel x:Name="DirectoryPreparationActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="已确认目标目录" MinWidth="136" Click="OnConfirmDirectoryPrepared"
                            AutomationProperties.Name="已确认目标目录" />
                    <Button Content="取消" MinWidth="90" Margin="10,0,0,0" Click="OnCancelDirectoryPreparation"
                            AutomationProperties.Name="取消目录准备" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="BaiduBatchTransfer.App.Features.Accounts.BaiduLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}" Icon="{DynamicResource ProductWindowIcon}"
        Width="1120" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Instructions}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="16" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <!-- 没装 WebView2 时登录窗口只剩空白：给一个直接打开微软官网下载页的按钮。 -->
                <Button x:Name="DownloadWebView2Button" DockPanel.Dock="Right" Content="下载 WebView2"
                        Click="OnDownloadWebView2Click" Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center"
                        Visibility="{Binding ShowRuntimeDownload, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="打开微软官网的 WebView2 下载页，下载「常青版引导程序」安装。" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

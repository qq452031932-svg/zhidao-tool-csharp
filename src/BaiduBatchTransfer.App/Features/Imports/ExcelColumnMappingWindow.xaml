<Window x:Class="BaiduBatchTransfer.App.Features.Imports.ExcelColumnMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认 Excel 列对应" Width="820" Height="620"
        MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Excel 列对应确认窗口">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="确认 Excel 列对应" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="请确认每一列的用途。分享链接必须且只能选择一列；源标题和提取码可以不选，其余列将原样保留。" />
            <CheckBox Content="首个内容行是表头" IsChecked="{Binding FirstRowIsHeader}"
                      AutomationProperties.Name="首个内容行是表头" />
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="0,10,0,12" ItemsSource="{Binding Columns}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="列用途对应表">
            <DataGrid.Columns>
                <DataGridTextColumn Header="列号" Binding="{Binding SourceColumnIndex}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="源表头" Binding="{Binding Header}" IsReadOnly="True" Width="*" />
                <DataGridTemplateColumn Header="用途" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Role" SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="选择列用途" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="前 20 行安全预览" FontWeight="SemiBold" />
        <DataGrid Grid.Row="3" Margin="0,8,0,12" ItemsSource="{Binding PreviewRows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="Excel 内容预览">
            <DataGrid.Columns>
                <DataGridTextColumn Header="行号" Binding="{Binding SourceRowNumber}" Width="80" />
                <DataGridTextColumn Header="原始单元格（仅在此窗口显示）" Binding="{Binding ValuesText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#B42318" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
                        AutomationProperties.Name="取消列对应" />
                <Button Content="确认并导入" Width="120" IsDefault="True" Click="Confirm_Click"
                        AutomationProperties.Name="确认列对应并导入" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

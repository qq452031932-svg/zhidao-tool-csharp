<UserControl x:Class="BaiduBatchTransfer.App.Features.Home.HomeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="480" MinHeight="320">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- 软件信息 -->
        <Border Grid.Column="0" Style="{StaticResource BorderedPanelStyle}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProductName}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <Border Margin="9,0,0,0" Padding="7,2" VerticalAlignment="Center"
                                Background="{StaticResource NavSelectedBrush}" CornerRadius="9">
                            <TextBlock Text="{Binding VersionDisplay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Tagline}" Margin="0,7,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />

                    <ItemsControl ItemsSource="{Binding Features}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="10,0,0,0"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,6,0,0" Padding="12" CornerRadius="5"
                            Background="{StaticResource ElevatedBrush}">
                        <TextBlock Text="{Binding ContactHint}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 更新日志 -->
        <Border Grid.Column="2" Style="{StaticResource BorderedPanelStyle}" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="更新日志" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text="每个版本改了什么，离线也看得到。" Margin="0,5,0,12"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Changelog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,6,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding ReleasedOn}" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="{StaticResource AccentBrush}"
                                                               VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Margin="7,0,0,0"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

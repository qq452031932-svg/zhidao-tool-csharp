<UserControl x:Class="BaiduBatchTransfer.App.Features.Transfers.TransferWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="转存工作台">
    <Grid Margin="0,0,10,0">
        <Grid.Resources>
            <Style x:Key="DangerHistoryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="#B42318" />
                <Setter Property="BorderBrush" Value="#B42318" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderThickness" Value="3" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TransferToolbar" Grid.Row="0"
                Style="{StaticResource BorderedPanelStyle}" Padding="10,8" Margin="0,0,0,8"
                IsEnabled="{Binding CanEditConfiguration}">
            <!-- 配置区可折叠，并且开始转存后自动收起（见 IsConfigurationExpanded）。
                 展开时它占掉大半屏，下方表格只剩三四行；而任务跑起来之后
                 配置已经不能再改（整个 Border 被 CanEditConfiguration 禁用），留着只是挡着结果。 -->
            <Expander x:Name="ConfigurationExpander" Style="{StaticResource FlatExpanderStyle}"
                      IsExpanded="{Binding IsConfigurationExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <!-- 标题与说明排成一行：两行版头白吃掉0 多像素的垂直空间。 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="导入与配置" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="选择来源、目标目录与并发，然后开始转存"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Expander.Header>
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel x:Name="TopConfigurationToolbar" Grid.Row="0">
                    <Button Content="导入粘贴内容" Command="{Binding Import.ImportTextCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="2,4" Margin="0,0,2,6" />
                    <Button Content="选择 Excel" Command="{Binding Import.SelectAndImportExcelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="2,4" Margin="0,0,2,6" />
                    <Button Content="清空" Command="{Binding ClearCurrentImportCommand}"
                            AutomationProperties.Name="清空当前导入"
                            AutomationProperties.HelpText="只清除本地待处理导入，不影响百度网盘文件和分享链接"
                            ToolTip="只清除本地待处理导入，不影响百度网盘文件和分享链接"
                            Style="{StaticResource DangerHistoryButton}"
                            Padding="2,4" Margin="0,0,2,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                        <TextBlock Text="目标目录" ToolTip="默认目标目录" AutomationProperties.Name="默认目标目录"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                        <Button MinWidth="100" MaxWidth="180"
                                Content="{Binding Wizard.DefaultTargetPath}"
                                ToolTip="{Binding Wizard.DefaultTargetPath}"
                                Command="{Binding PickTargetDirectoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                AutomationProperties.Name="选择百度保存目录" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                        <TextBlock Text="并发" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                        <ComboBox Width="58" ItemsSource="{Binding ConcurrencyOptions}"
                                  SelectedItem="{Binding MaxConcurrency}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                        <TextBlock Text="结果目录" ToolTip="结果保存目录" AutomationProperties.Name="结果保存目录"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                        <TextBox x:Name="ShareResultDirectoryInput" Width="100"
                                 Text="{Binding ShareResultDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="本机结果目录" ToolTip="本机结果目录"
                                 VerticalContentAlignment="Center" />
                        <Button Content="选择目录" Command="{Binding PickShareResultDirectoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" Margin="4,0,0,0" />
                    </StackPanel>
                    <Button x:Name="StartTransferButton" Content="开始转存"
                            Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                            ToolTip="{Binding ConfigurationMessage}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.HelpText="{Binding Wizard.ValidationMessage}"
                            FontWeight="SemiBold" Padding="10,4" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBox x:Name="BulkPasteInput" Grid.Row="1" MinLines="2" MaxLines="8" Margin="0,4,0,0"
                         Text="{Binding Import.TextContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="百度分享文字" ToolTip="可一次粘贴多条分享链接，支持标题和提取码"
                         VerticalAlignment="Top" VerticalContentAlignment="Top">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Height" Value="Auto" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
            </Expander>
        </Border>

        <Border x:Name="TransferDataRegion" Grid.Row="1"
                Style="{StaticResource BorderedPanelStyle}" Padding="0" Margin="0,0,0,4">
            <Grid>
                <TabControl Margin="10,0,10,6"
                            SelectedIndex="{Binding SelectedDataTabIndex}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Padding" Value="16,9" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                    <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="DataViewToolbar" Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Import.StatisticsText}" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Import.StatisticsText}" />
                                    <TabPanel Grid.Column="1" IsItemsHost="True" VerticalAlignment="Center"
                                              KeyboardNavigation.TabIndex="1" />
                                    <StackPanel x:Name="AccountModeSelectors" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <RadioButton Content="单账号" GroupName="TransferAccountMode"
                                                     Command="{Binding SelectSingleAccountCommand}"
                                                     IsChecked="{Binding IsSingleAccountMode, Mode=OneWay}"
                                                     FontSize="12" Padding="2,2" Margin="0,0,6,0" />
                                        <RadioButton Content="多账号复制" GroupName="TransferAccountMode"
                                                     Command="{Binding SelectReplicationCommand}"
                                                     IsChecked="{Binding IsReplicationMode, Mode=OneWay}"
                                                     FontSize="12" Padding="2,2" Margin="0,0,6,0" />
                                        <RadioButton Content="多账号分流" GroupName="TransferAccountMode"
                                                     Command="{Binding SelectDistributionCommand}"
                                                     IsChecked="{Binding IsDistributionMode, Mode=OneWay}"
                                                     FontSize="12" Padding="2,2" Margin="0" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="待处理链接">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="PendingLinksGrid" ItemsSource="{Binding Import.Rows}"
                                      SelectedItem="{Binding Import.SelectedRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionMode="Single" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource DenseDataGridStyle}" RowHeight="34"
                                      IsReadOnly="True" EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除这条记录"
                                                  Command="{Binding PlacementTarget.DataContext.Import.DeleteSelectedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  ToolTip="从待处理列表中彻底删除，不能恢复；只想这次不转存请用「排除所选记录」。" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding DisplayOrdinal}" Width="58">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding SourceRowNumber, StringFormat=来源行号：{0}}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="原分享链接" Binding="{Binding ShareUrl}" Width="2*" />
                                    <DataGridTextColumn Header="原提取码" Binding="{Binding ExtractionCode}" Width="82" />
                                    <DataGridTextColumn Header="指定账号" Binding="{Binding RequestedAccountName}" Width="110" />
                                    <DataGridTextColumn Header="解析状态" Binding="{Binding PrecheckText}" Width="100" />
                                    <DataGridTextColumn Header="处理状态" Binding="{Binding DisplayDispositionText}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- 两行：上一行编辑所选记录，下一行筛选与翻页。挤在一行时链接输入框只剩几十像素。 -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Import.SelectedShareUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="修改所选记录的分享链接" VerticalContentAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="8,0,0,0"
                                         Text="{Binding Import.SelectedExtractionCode, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="修改所选记录的提取码" VerticalContentAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="保存修改" Command="{Binding Import.SaveSelectedRowCommand}" />
                                    <Button Content="{Binding Import.SelectedExclusionActionText}"
                                            Command="{Binding Import.ToggleSelectedExclusionCommand}" Margin="0" />
                                </StackPanel>
                                <CheckBox x:Name="ConflictsOnlyCheckBox" Grid.Row="1" Content="只看冲突"
                                          IsChecked="{Binding Import.ShowConflictsOnly, Mode=TwoWay}"
                                          IsEnabled="{Binding Import.CanFilterConflicts}"
                                          VerticalAlignment="Center" Margin="2,6,0,0"
                                          ToolTip="只列出「冲突待处理」的记录：同一个链接出现多次且提取码等设置不一致。排除或删除多余的那几条后才能开始转存。" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Import.PageText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <Button Content="刷新" Command="{Binding Import.LoadFirstPageCommand}" />
                                    <Button Content="上一页" Command="{Binding Import.LoadPreviousPageCommand}" />
                                    <Button Content="下一页" Command="{Binding Import.LoadNextPageCommand}" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="处理结果">
                        <DockPanel>
                            <!-- 重试入口此前只有命令没有按钮：功能、安全判定和测试都齐全，
                                 却没有任何地方能点到，失败项因此既重试不了、又会挡住清空历史。 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="4,8,4,0">
                                <Button x:Name="RetryFailedTransferButton"
                                        Content="重试所选失败项"
                                        Command="{Binding RunPanel.RetryFailedTransferCommand}"
                                        AutomationProperties.Name="重试所选失败项"
                                        Margin="0,0,10,0" Padding="12,4"
                                        ToolTip="把选中的失败转存重新排队。仅对可安全重试的记录可用：已提交过或需要先确认远端结果的不会重试。"
                                        ToolTipService.ShowOnDisabled="True" />
                                <Button Content="清空转存历史" Command="{Binding ClearTransferHistoryCommand}"
                                        AutomationProperties.Name="清空转存历史" Style="{StaticResource DangerHistoryButton}"
                                        Margin="0"
                                        ToolTip="{Binding ClearTransferHistoryHint}"
                                        ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                            <ContentControl x:Name="ResultsHost" Margin="4,8,4,4"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="运行日志">
                        <Border Margin="4,8,4,4" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="10,0,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="最近 100 条" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="清空日志" Command="{Binding ClearLogsCommand}"
                                            AutomationProperties.Name="清空运行日志" Margin="10,0,0,0" Padding="10,3" />
                                </Grid>
                                <ListBox x:Name="TransferLogsList" Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0"
                                         Background="Transparent" ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding LocalTimestamp, StringFormat={}{0:HH:mm:ss}}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#667085" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                    <Setter Property="Foreground" Value="#16803A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="#B7791F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#C53030" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TransferStatusLiveRegion" Grid.Row="1"
                                           Text="{Binding UserFacingStatusMessage}" Opacity="0" Width="1" Height="1"
                                           IsHitTestVisible="False" Focusable="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           AutomationProperties.Name="{Binding UserFacingStatusMessage}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>

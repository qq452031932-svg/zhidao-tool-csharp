<UserControl x:Class="BaiduBatchTransfer.App.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             MinHeight="240">
    <!-- 授权与 OTA 是两件事：授权信息原本嵌在“软件更新”标题之下，读起来像是
         更新功能的一部分。拆成两张卡片，授权在上，更新在下。 -->
    <StackPanel>
    <Border Style="{StaticResource BorderedPanelStyle}" Padding="22" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock Text="软件授权"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrandBrush}" />
            <TextBlock Text="当前卡密套餐与机器绑定状态。"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}" />
        <Border
                Margin="0,14,0,0"
                Padding="14"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="套餐" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="20,0,0,0" Text="{Binding LicensePackageName}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Text="到期时间" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="20,8,0,0" Text="{Binding LicenseExpiresAt}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Text="授权状态" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="20,8,0,0" Text="{Binding LicenseAuthorizationStatus}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Text="机器绑定状态" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="20,8,0,0" Text="{Binding LicenseMachineBindingStatus}" />
                <!-- 机器码：用户联系管理员解绑时靠它定位设备。完整哈希过长，
                     界面只显示首尾各 8 位，复制按钮给出完整值。 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Text="机器码" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="20,8,0,0">
                    <TextBlock Text="{Binding MachineCodeDisplay}" VerticalAlignment="Center"
                               FontFamily="Consolas, Microsoft YaHei UI" />
                    <Button Content="复制" Margin="10,0,0,0" Padding="10,2" Height="26"
                            Command="{Binding CopyMachineCodeCommand}"
                            AutomationProperties.Name="复制机器码" />
                </StackPanel>
                <!-- 未授权时才出现。激活窗此前只在启动时弹一次，
                     用户点“暂不激活”后没有任何入口可以再次激活。 -->
                <Button Grid.Row="4" Grid.Column="1"
                        Margin="20,14,0,0"
                        HorizontalAlignment="Left"
                        MinWidth="120"
                        Style="{StaticResource PrimaryButton}"
                        Content="激活软件"
                        Command="{Binding ActivateLicenseCommand}"
                        AutomationProperties.Name="激活软件">
                    <Button.Visibility>
                        <Binding Path="CanActivateLicense"
                                 Converter="{StaticResource BooleanToVisibilityConverter}" />
                    </Button.Visibility>
                </Button>
            </Grid>
        </Border>
        </StackPanel>
    </Border>
    <Border Style="{StaticResource BorderedPanelStyle}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="软件更新（OTA 在线更新）"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrush}" />
                <TextBlock Text="检查并安装安全发布的新版本。"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding BuildLabel}"
                           Margin="0,5,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrush}" />
            </StackPanel>


            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="20,0,0,0" Text="{Binding CurrentVersion}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="更新状态" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="20,10,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding StatusMessage, StringFormat=更新状态：{0}}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="最新版本" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="20,10,0,0" Text="{Binding LatestVersion, TargetNullValue=--}" />
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,20,0,0"
                    Padding="14"
                    Background="{StaticResource WarningRowBrush}"
                    BorderBrush="#FFF0C36A"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="更新说明" FontWeight="SemiBold" Foreground="#FF8A5A00" />
                    <ScrollViewer Margin="0,7,0,0"
                                  MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes, TargetNullValue=暂无更新说明。}"
                                   Foreground="#FF6F4B00"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <ProgressBar Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadProgress, Mode=OneWay}"
                             AutomationProperties.Name="更新下载进度"
                             AutomationProperties.HelpText="显示更新下载进度，范围为 0% 到 100%。" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding DownloadProgress, StringFormat={}{0}%}" />
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="检查更新"
                        Command="{Binding CheckForUpdatesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="18,7" />
                <Button Margin="10,0,0,0"
                        Content="{Binding UpdateActionText, FallbackValue=立即更新并重启}"
                        Command="{Binding UpdateAndRestartCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="{StaticResource BrandBrush}"
                        Padding="18,7" />
            </StackPanel>
        </Grid>
    </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="BaiduBatchTransfer.App.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             MinHeight="240">
    <Border Style="{StaticResource BorderedPanelStyle}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="软件更新（OTA 在线更新）"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrush}" />
                <TextBlock Text="检查并安装安全发布的新版本。"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding BuildLabel}"
                           Margin="0,5,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="20,0,0,0" Text="{Binding CurrentVersion}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="更新状态" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="20,10,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding StatusMessage, StringFormat=更新状态：{0}}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="最新版本" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="20,10,0,0" Text="{Binding LatestVersion, TargetNullValue=--}" />
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="14"
                    Background="#FFF8E1"
                    BorderBrush="#FFF0C36A"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="更新说明" FontWeight="SemiBold" Foreground="#FF8A5A00" />
                    <ScrollViewer Margin="0,7,0,0"
                                  MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes, TargetNullValue=暂无更新说明。}"
                                   Foreground="#FF6F4B00"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <ProgressBar Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadProgress, Mode=OneWay}"
                             AutomationProperties.Name="更新下载进度"
                             AutomationProperties.HelpText="显示更新下载进度，范围为 0% 到 100%。" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding DownloadProgress, StringFormat={}{0}%}" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="检查更新"
                        Command="{Binding CheckForUpdatesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="18,7" />
                <Button Margin="10,0,0,0"
                        Content="{Binding UpdateActionText, FallbackValue=立即更新并重启}"
                        Command="{Binding UpdateAndRestartCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="{StaticResource BrandBrush}"
                        Padding="18,7" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="BaiduBatchTransfer.App.Features.Shares.ShareWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="分享工作台">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <Border x:Name="ShareToolbar" Grid.Row="0"
                Style="{StaticResource BorderedPanelStyle}" Padding="10,6" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel x:Name="ShareToolbarWrap" Orientation="Horizontal">
                    <TextBlock Text="当前账号" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                    <ComboBox Width="126" Height="34" ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding ActiveAccount}" DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CanEditSelection}"
                              AutomationProperties.Name="当前分享账号" Margin="0,0,8,0" />
                    <Button Content="从网盘选择" Command="{Binding PickResourcesCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="从当前账号网盘选择资源" />
                    <CheckBox Content="固定提取码" IsChecked="{Binding UseFixedExtractionCode}"
                              IsEnabled="{Binding CanEditSelection}" VerticalAlignment="Center"
                              AutomationProperties.Name="使用固定提取码" Margin="0,0,6,0" />
                    <TextBox Width="72" Height="34" MaxLength="4" VerticalContentAlignment="Center"
                             Text="{Binding FixedExtractionCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UseFixedExtractionCode}"
                             AutomationProperties.Name="四位固定提取码" Margin="0,0,8,0" />
                    <TextBlock Text="不勾选时自动生成随机提取码" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="永久有效 · 不限次数" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                    <TextBox Width="164" Height="34" IsReadOnly="True" VerticalContentAlignment="Center"
                             Text="{Binding ResultDirectory}" ToolTip="分享结果保存目录"
                             AutomationProperties.Name="分享结果保存目录" Margin="0,0,4,0" />
                    <Button Content="选择目录" Command="{Binding ChooseResultDirectoryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="选择分享结果保存目录" />
                    <Button Content="开始分享" Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" FontSize="16" FontWeight="SemiBold"
                            MinWidth="112" Margin="0"
                            AutomationProperties.Name="开始分享" />
                </WrapPanel>

                <Expander x:Name="AdvancedSettingsExpander" Header="高级设置"
                          IsEnabled="{Binding CanUseAdvancedSettings}"
                          HorizontalContentAlignment="Stretch" Margin="0,3,0,0">
                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                            Padding="0,8,0,0" MaxHeight="110">
                        <ScrollViewer x:Name="AdvancedSettingsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel>
                                <TextBlock Text="已有分享处理" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                <ComboBox MinWidth="220" Height="34"
                                          ItemsSource="{Binding ExistingShareDecisionOptions}"
                                          SelectedItem="{Binding SelectedExistingShareDecision}"
                                          IsEnabled="{Binding CanEditSelection}"
                                          AutomationProperties.Name="已有分享处理方式" Margin="0,0,8,0" />
                                <Button Content="恢复未完成选择" Command="{Binding ResetPendingDraftCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        AutomationProperties.Name="检查上次分享任务是否已经创建" />
                            </WrapPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <Border x:Name="ShareDataRegion" Grid.Row="1"
                Style="{StaticResource BorderedPanelStyle}" Padding="0" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分享数据" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedResourceCount, StringFormat=已选择 {0} 项资源}"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="永久有效 · 不限次数"
                               Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                </Grid>

                <TabControl Grid.Row="1" Margin="8,0,8,8">
                    <TabItem Header="待分享资源">
                        <Grid Margin="4,8,4,4">
                            <DataGrid ItemsSource="{Binding PendingRows}"
                                      Style="{StaticResource DenseDataGridStyle}"
                                      RowHeight="34" ColumnHeaderHeight="38" IsReadOnly="True"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      AutomationProperties.Name="待分享资源">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="网盘路径" Binding="{Binding ParentPath}" Width="2*" />
                                    <DataGridTextColumn Header="目标账号" Binding="{Binding AccountDisplayName}" Width="110" />
                                    <DataGridTextColumn Header="已有分享处理" Binding="{Binding ExistingSharePolicyDisplay}" Width="155" />
                                    <DataGridTextColumn Header="准备状态" Binding="{Binding ReadinessText}" Width="90" />
                                    <DataGridTemplateColumn Header="操作" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="移除" Padding="8,2" MinHeight="26" Margin="0"
                                                        CommandParameter="{Binding Selection}"
                                                        Command="{Binding DataContext.RemoveSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.Name="移除所选资源" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="暂无待分享资源，请先从网盘选择。" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <TabItem Header="分享结果">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox Width="180" Height="34" ItemsSource="{Binding Batches}"
                                          SelectedItem="{Binding SelectedBatch}"
                                          IsEnabled="{Binding CanSelectHistory}"
                                          AutomationProperties.Name="分享任务历史">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="上一页" Command="{Binding PreviousHistoryPageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding HistoryPageText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="下一页" Command="{Binding NextHistoryPageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="查看" Command="{Binding LoadSelectedBatchCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="暂停" Command="{Binding PauseCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="继续" Command="{Binding ResumeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="重试失败项" Command="{Binding RetryFailedCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="保存结果" Command="{Binding SaveResultsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        AutomationProperties.Name="保存分享结果" />
                                <Button Content="取消保存" Command="{Binding CancelSaveResultsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        AutomationProperties.Name="取消保存分享结果" />
                            </WrapPanel>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding ResultRows}"
                                          SelectedValuePath="Operation" SelectedValue="{Binding SelectedOperation}"
                                          IsEnabled="{Binding CanSelectHistory}"
                                          Style="{StaticResource DenseDataGridStyle}"
                                          RowHeight="34" ColumnHeaderHeight="38" IsReadOnly="True"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          AutomationProperties.Name="分享结果"
                                          AutomationProperties.HelpText="状态包括等待分享、正在分享、等待确认和已完成">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                                        <DataGridTextColumn Header="账号" Binding="{Binding AccountDisplayName}" Width="105" />
                                        <DataGridTextColumn Header="分享状态" Binding="{Binding StatusDisplay}" Width="90" />
                                        <DataGridTextColumn Header="分享链接" Binding="{Binding NewShareUrl}" Width="2*" />
                                        <DataGridTextColumn Header="提取码" Binding="{Binding NewExtractionCode}" Width="82" />
                                        <DataGridTextColumn Header="完成时间" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                                        <DataGridTextColumn Header="结果保存" Binding="{Binding ResultSaveStatus}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="暂无分享结果。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultRows.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border x:Name="ShareLogRegion" Grid.Row="2"
                Style="{StaticResource BorderedPanelStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="最近 100 条" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="清空日志" Command="{Binding ClearLogsCommand}"
                                AutomationProperties.Name="清空运行日志" Margin="10,0,0,0" Padding="10,3" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LocalTimestamp, StringFormat={}{0:HH:mm:ss}}"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#667085" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="#16803A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#B7791F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#C53030" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ShareStatusLiveRegion" Grid.Row="1"
                           Text="{Binding UserFacingStatusMessage}" Opacity="0" Width="1" Height="1"
                           IsHitTestVisible="False" Focusable="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           AutomationProperties.Name="{Binding UserFacingStatusMessage}"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

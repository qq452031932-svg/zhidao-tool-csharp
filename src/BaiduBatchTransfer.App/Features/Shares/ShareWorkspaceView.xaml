<UserControl x:Class="BaiduBatchTransfer.App.Features.Shares.ShareWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:BaiduBatchTransfer.Core.Domain;assembly=BaiduBatchTransfer.Core"
             xmlns:contracts="clr-namespace:BaiduBatchTransfer.Core.Abstractions;assembly=BaiduBatchTransfer.Core"
             MinWidth="760" MinHeight="520"
             AutomationProperties.Name="分享工作区">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="分享" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#52606D"
                           Text="选择账号自己的网盘资源，每一项会单独生成分享结果。"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Padding="18" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="1. 选择网盘资源" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock Width="86" VerticalAlignment="Center" Text="当前账号" />
                        <ComboBox Width="240"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding ActiveAccount}"
                                  IsEnabled="{Binding CanEditSelection}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="当前分享账号" />
                        <Button Margin="10,0,0,0" Padding="18,7"
                                Content="从网盘选择"
                                Command="{Binding PickResourcesCommand}"
                                AutomationProperties.Name="从当前账号网盘选择资源" />
                    </StackPanel>

                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding SelectionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding AccountDisplayName}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Selections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="文件" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:RemoteResourceKind.Folder}">
                                                                            <Setter Property="Text" Value="文件夹" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="#7B8794" FontSize="11" Text="{Binding ParentPath}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Margin="12,0,0,0" Padding="10,3" Content="移除"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.RemoveSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                AutomationProperties.Name="移除所选资源" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="#52606D" Text="{Binding SelectedResourceCount, StringFormat=已选择 {0} 项资源}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="18" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="2. 选择结果保存位置并开始" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center"
                                  Content="使用固定提取码"
                                  IsChecked="{Binding UseFixedExtractionCode}"
                                  IsEnabled="{Binding CanEditSelection}"
                                  AutomationProperties.Name="使用固定提取码" />
                        <TextBox Width="100" Margin="12,0,0,0" Padding="7,5" MaxLength="4"
                                 Text="{Binding FixedExtractionCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseFixedExtractionCode}"
                                 AutomationProperties.Name="四位固定提取码" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#52606D"
                                   Text="不勾选时自动生成随机提取码" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Width="120" VerticalAlignment="Center" Text="已有分享处理" />
                        <ComboBox MinWidth="230"
                                  ItemsSource="{Binding ExistingShareDecisionOptions}"
                                  SelectedItem="{Binding SelectedExistingShareDecision}"
                                  IsEnabled="{Binding CanEditSelection}"
                                  AutomationProperties.Name="已有分享处理方式" />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinHeight="32" Padding="7,5" IsReadOnly="True"
                                 Text="{Binding ResultDirectory}"
                                 AutomationProperties.Name="分享结果保存目录" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,6" Content="选择目录"
                                Command="{Binding ChooseResultDirectoryCommand}"
                                AutomationProperties.Name="选择分享结果保存目录" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Padding="22,6" Content="开始分享"
                                Background="#1769FF" Foreground="White"
                                Command="{Binding StartCommand}"
                                AutomationProperties.Name="开始分享" />
                    </Grid>
                    <Button Margin="0,10,0,0" Padding="14,5" HorizontalAlignment="Left"
                            Content="检查上次创建结果"
                            Command="{Binding ResetPendingDraftCommand}"
                            AutomationProperties.Name="检查上次分享任务是否已经创建" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,14,0,24" Padding="18" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="任务进度与历史" FontSize="18" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontWeight="SemiBold" Text="分享任务" />
                            <ListBox Margin="0,7,0,0" MinHeight="120"
                                     ItemsSource="{Binding Batches}"
                                     SelectedItem="{Binding SelectedBatch}"
                                     IsEnabled="{Binding CanSelectHistory}"
                                     AutomationProperties.Name="分享任务历史">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                            <TextBlock Foreground="#52606D" Text="{Binding OperationCount, StringFormat={}{0} 项资源}" />
                                            <TextBlock Foreground="#1769FF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="等待分享" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareBatchStatus.Active}">
                                                                <Setter Property="Text" Value="正在分享" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareBatchStatus.Paused}">
                                                                <Setter Property="Text" Value="已暂停" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareBatchStatus.Completed}">
                                                                <Setter Property="Text" Value="已完成" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareBatchStatus.CompletedWithFailures}">
                                                                <Setter Property="Text" Value="部分失败" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareBatchStatus.Cancelled}">
                                                                <Setter Property="Text" Value="已取消" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Button Padding="10,4" Content="上一页"
                                        Command="{Binding PreviousHistoryPageCommand}"
                                        AutomationProperties.Name="上一页分享任务" />
                                <TextBlock Margin="10,0" VerticalAlignment="Center"
                                           Text="{Binding HistoryPageText}"
                                           AutomationProperties.Name="分享任务历史页码" />
                                <Button Padding="10,4" Content="下一页"
                                        Command="{Binding NextHistoryPageCommand}"
                                        AutomationProperties.Name="下一页分享任务" />
                            </StackPanel>
                            <Button Margin="0,8,0,0" Padding="12,5" Content="查看所选任务"
                                    Command="{Binding LoadSelectedBatchCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="当前任务明细" />
                            <ListBox Margin="0,7,0,0" MinHeight="120"
                                     ItemsSource="{Binding Operations}"
                                     SelectedItem="{Binding SelectedOperation}"
                                     IsEnabled="{Binding CanSelectHistory}"
                                     AutomationProperties.Name="当前分享任务明细">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="#1769FF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="等待分享" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Reserved}">
                                                                <Setter Property="Text" Value="正在分享" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Preparing}">
                                                                <Setter Property="Text" Value="正在分享" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Submitting}">
                                                                <Setter Property="Text" Value="正在分享" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.ResultPending}">
                                                                <Setter Property="Text" Value="等待确认" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Succeeded}">
                                                                <Setter Property="Text" Value="已完成" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Failed}">
                                                                <Setter Property="Text" Value="失败" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Paused}">
                                                                <Setter Property="Text" Value="已暂停" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static contracts:StandaloneShareOperationStatus.Cancelled}">
                                                                <Setter Property="Text" Value="已取消" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Button Padding="12,5" Content="暂停" Command="{Binding PauseCommand}" />
                                <Button Margin="8,0,0,0" Padding="12,5" Content="继续" Command="{Binding ResumeCommand}" />
                                <Button Margin="8,0,0,0" Padding="12,5" Content="重试失败项" Command="{Binding RetryFailedCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Foreground="#B54708" Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="分享状态提示" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

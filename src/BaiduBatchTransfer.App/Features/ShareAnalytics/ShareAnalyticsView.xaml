<UserControl x:Class="BaiduBatchTransfer.App.Features.ShareAnalytics.ShareAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:BaiduBatchTransfer.Core.Domain;assembly=BaiduBatchTransfer.Core"
             xmlns:analytics="clr-namespace:BaiduBatchTransfer.Application.ShareAnalytics;assembly=BaiduBatchTransfer.Application"
             xmlns:common="clr-namespace:BaiduBatchTransfer.App.Features.Common">
    <UserControl.Resources>
        <!-- 列头不在可视树上，RelativeSource 找不到 DataGrid，绑定会静默失败；经此代理取视图模型 -->
        <common:BindingProxy x:Key="AnalyticsVm" Data="{Binding}" />
        <SolidColorBrush x:Key="ShareAnalyticsSortedHeaderBrush" Color="#FFF3C4" />
        <SolidColorBrush x:Key="ShareAnalyticsSortedCellBrush" Color="#FFF9E3" />

        <Style x:Key="ShareAnalyticsColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ShareAnalyticsSortButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="4,0,0,0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#E8EBEF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="↑">
                                <Setter TargetName="HeaderSurface" Property="Background"
                                        Value="{StaticResource ShareAnalyticsSortedHeaderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="↓">
                                <Setter TargetName="HeaderSurface" Property="Background"
                                        Value="{StaticResource ShareAnalyticsSortedHeaderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareAnalyticsRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShareAnalyticsCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShareAnalyticsSortCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource ShareAnalyticsCellStyle}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ShareAnalyticsToolbar" Style="{StaticResource BorderedPanelStyle}"
                Padding="10,6" Margin="0,0,0,6" TextElement.FontSize="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ShareSummaryToolbar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentAccountName}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentAccountName}" />
                        <TextBlock Grid.Column="1" Text="{Binding LastSuccessfulSyncText, StringFormat=缓存 {0}}" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <TextBlock Text="{Binding CacheStatusText}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="转存" Command="{Binding SelectMetricCommand}"
                                CommandParameter="{x:Static domain:AccountShareMetric.Transfer}" Padding="8,4" Margin="0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsTransferSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="浏览" Command="{Binding SelectMetricCommand}"
                                CommandParameter="{x:Static domain:AccountShareMetric.View}" Padding="8,4" Margin="4,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsViewSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="下载" Command="{Binding SelectMetricCommand}"
                                CommandParameter="{x:Static domain:AccountShareMetric.Download}" Padding="8,4" Margin="4,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsDownloadSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount, StringFormat=全部 {0:N0}}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ValidCount, StringFormat=有效 {0:N0}}" Foreground="#067647" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding InvalidCount, StringFormat=失效 {0:N0}}" Foreground="#B42318" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                            ToolTip="{Binding StatusMessage}" AutomationProperties.HelpText="{Binding StatusMessage}"
                            Margin="0" Padding="10,4">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Content" Value="刷新数据" /><Style.Triggers><DataTrigger Binding="{Binding IsRefreshing}" Value="True"><Setter Property="Content" Value="刷新中…" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
                <Grid x:Name="SelectionToolbar" Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleSearchInput" MinWidth="90"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             AutomationProperties.Name="标题搜索" ToolTip="按标题搜索，回车立即筛选" />
                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusOption}" DisplayMemberPath="Label" />
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="已选 {0:N0} / {1:N0}">
                                <Binding Path="SelectedCount" />
                                <Binding Path="CurrentResultCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.ToolTip>
                            <MultiBinding StringFormat="已选 {0:N0} 条 / 当前结果 {1:N0} 条">
                                <Binding Path="SelectedCount" />
                                <Binding Path="CurrentResultCount" />
                            </MultiBinding>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="序号" Margin="0,0,4,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBox Width="36" AutomationProperties.Name="选取起始序号"
                                 Text="{Binding RangeStartText, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Padding="5,3" />
                        <TextBlock Text="至" Margin="4,0" VerticalAlignment="Center" />
                        <TextBox Width="36" AutomationProperties.Name="选取结束序号"
                                 Text="{Binding RangeEndText, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" Padding="5,3" />
                        <Button Content="选取" Command="{Binding SelectRangeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" Margin="6,0,0,0" />
                        <Button Content="全选" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" Margin="4,0,0,0" />
                        <Button Content="反选" Command="{Binding InvertSelectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" Margin="4,0,0,0" />
                        <Button Content="清空选择" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" Margin="4,0,0,0" />
                        <Button Content="导出表格" Command="{Binding ExportCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="8,4" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource BorderedPanelStyle}" Padding="8">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding VisibleItems}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource ShareAnalyticsColumnHeaderStyle}"
                      RowStyle="{StaticResource ShareAnalyticsRowStyle}"
                      CellStyle="{StaticResource ShareAnalyticsCellStyle}"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                            <Button AutomationProperties.Name="选择当前结果"
                                    Command="{Binding Data.ToggleHeaderSelectionCommand, Source={StaticResource AnalyticsVm}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0">
                                <CheckBox AutomationProperties.Name="选择"
                                          IsHitTestVisible="False" Focusable="False"
                                          IsThreeState="True"
                                          IsChecked="{Binding Data.HeaderSelectionState, Source={StaticResource AnalyticsVm}, Mode=OneWay}" />
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="序号" AutomationProperties.Name="序号"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Sequence}" TextAlignment="Right" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.HistoricalTotal}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="历史累计"
                                    AutomationProperties.Name="历史累计"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.HistoricalTotalSortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.HistoricalTotal}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HistoricalTotalText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.NewValue}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="新增"
                                    AutomationProperties.Name="新增"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.NewValueSortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.NewValue}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NewText}" Foreground="{Binding NewForeground}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.Today}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="今天"
                                    AutomationProperties.Name="今天"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.TodaySortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.Today}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TodayText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.Yesterday}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="昨天"
                                    AutomationProperties.Name="昨天"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.YesterdaySortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.Yesterday}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding YesterdayText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay2}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Data.PriorDay2Header, Source={StaticResource AnalyticsVm}}"
                                    AutomationProperties.Name="{Binding Data.PriorDay2Header, Source={StaticResource AnalyticsVm}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.PriorDay2SortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay2}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay2Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay3}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Data.PriorDay3Header, Source={StaticResource AnalyticsVm}}"
                                    AutomationProperties.Name="{Binding Data.PriorDay3Header, Source={StaticResource AnalyticsVm}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.PriorDay3SortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay3}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay3Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.SortColumn, Source={StaticResource AnalyticsVm}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay4}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Data.PriorDay4Header, Source={StaticResource AnalyticsVm}}"
                                    AutomationProperties.Name="{Binding Data.PriorDay4Header, Source={StaticResource AnalyticsVm}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding Data.PriorDay4SortGlyph, Source={StaticResource AnalyticsVm}}"
                                    Command="{Binding Data.SortCommand, Source={StaticResource AnalyticsVm}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay4}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay4Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="76">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="链接" AutomationProperties.Name="链接"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="打开" Command="{Binding Data.OpenCommand, Source={StaticResource AnalyticsVm}}" CommandParameter="{Binding}" Padding="8,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="260">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="标题" AutomationProperties.Name="标题"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                           Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="90">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="状态" AutomationProperties.Name="状态"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 刷新结果（成功、失败原因、未激活）原来只在鼠标悬停提示里，点了像没反应。 -->
            <TextBlock x:Name="ShareAnalyticsStatus" Grid.Row="1" Margin="2,6,2,0" FontSize="12"
                       Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

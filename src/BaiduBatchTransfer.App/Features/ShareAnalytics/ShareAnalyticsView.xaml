<UserControl x:Class="BaiduBatchTransfer.App.Features.ShareAnalytics.ShareAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:BaiduBatchTransfer.Core.Domain;assembly=BaiduBatchTransfer.Core"
             xmlns:analytics="clr-namespace:BaiduBatchTransfer.Application.ShareAnalytics;assembly=BaiduBatchTransfer.Application">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ShareAnalyticsSortedHeaderBrush" Color="#FFF3C4" />
        <SolidColorBrush x:Key="ShareAnalyticsSortedCellBrush" Color="#FFF9E3" />

        <Style x:Key="ShareAnalyticsColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ShareAnalyticsSortButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="4,0,0,0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#E8EBEF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="↑">
                                <Setter TargetName="HeaderSurface" Property="Background"
                                        Value="{StaticResource ShareAnalyticsSortedHeaderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="↓">
                                <Setter TargetName="HeaderSurface" Property="Background"
                                        Value="{StaticResource ShareAnalyticsSortedHeaderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareAnalyticsCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ShareAnalyticsSortCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource ShareAnalyticsCellStyle}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource BorderedPanelStyle}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="分享数据" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="当前账号：" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding CurrentAccountName}" FontWeight="SemiBold" />
                        <TextBlock Text="　" />
                        <TextBlock Text="{Binding CacheStatusText}" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="刷新数据" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0" Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource BorderedPanelStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TotalCount, StringFormat=全部 {0:N0}}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ValidCount, StringFormat=有效 {0:N0}}" Foreground="#1E8E5A" Margin="18,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding InvalidCount, StringFormat=失效 {0:N0}}" Foreground="#E5484D" Margin="18,0,0,0" />
                    <Button Grid.Column="4" Content="转存" Command="{Binding SelectMetricCommand}"
                            CommandParameter="{x:Static domain:AccountShareMetric.Transfer}" Padding="14,4" Margin="0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsTransferSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Grid.Column="5" Content="浏览" Command="{Binding SelectMetricCommand}"
                            CommandParameter="{x:Static domain:AccountShareMetric.View}" Padding="14,4" Margin="6,0,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsViewSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Grid.Column="6" Content="下载" Command="{Binding SelectMetricCommand}"
                            CommandParameter="{x:Static domain:AccountShareMetric.Download}" Padding="14,4" Margin="6,0,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsDownloadSelected}" Value="True"><Setter Property="Background" Value="{StaticResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{StaticResource BrandBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                             ToolTip="按标题搜索" />
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusOption}" DisplayMemberPath="Label" />
                    <TextBlock Grid.Column="2" Text="点击表头切换升序/降序；缺失数据始终排在最后"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </Grid>
                <StackPanel x:Name="SelectionToolbar" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat=已选 {0:N0} 条}" VerticalAlignment="Center" />
                    <TextBlock Text=" / 共 " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentResultCount, StringFormat={}{0:N0} 条}" VerticalAlignment="Center" />
                    <TextBlock Text="　｜　从" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox Width="54" AutomationProperties.Name="选取起始序号"
                             Text="{Binding RangeStartText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" Padding="5,3" />
                    <TextBlock Text="到" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox Width="54" AutomationProperties.Name="选取结束序号"
                             Text="{Binding RangeEndText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" Padding="5,3" />
                    <TextBlock Text="　｜　" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Button Content="选取" Command="{Binding SelectRangeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0" />
                    <Button Content="全选" Command="{Binding SelectAllCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="6,0,0,0" />
                    <Button Content="反选" Command="{Binding InvertSelectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="6,0,0,0" />
                    <Button Content="清空选择" Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="6,0,0,0" />
                    <Button Content="导出表格" Command="{Binding ExportCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,4" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource BorderedPanelStyle}" Padding="8">
            <DataGrid ItemsSource="{Binding VisibleItems}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource ShareAnalyticsColumnHeaderStyle}"
                      CellStyle="{StaticResource ShareAnalyticsCellStyle}"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                            <Button AutomationProperties.Name="选择当前结果"
                                    Command="{Binding DataContext.ToggleHeaderSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0">
                                <CheckBox AutomationProperties.Name="选择"
                                          IsHitTestVisible="False" Focusable="False"
                                          IsThreeState="True"
                                          IsChecked="{Binding DataContext.HeaderSelectionState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="序号" AutomationProperties.Name="序号"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Sequence}" TextAlignment="Right" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.HistoricalTotal}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="历史累计"
                                    AutomationProperties.Name="历史累计"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.HistoricalTotalSortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.HistoricalTotal}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HistoricalTotalText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.NewValue}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="新增"
                                    AutomationProperties.Name="新增"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.NewValueSortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.NewValue}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NewText}" Foreground="{Binding NewForeground}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.Today}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="今天"
                                    AutomationProperties.Name="今天"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.TodaySortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.Today}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TodayText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="82">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.Yesterday}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="昨天"
                                    AutomationProperties.Name="昨天"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.YesterdaySortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.Yesterday}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding YesterdayText}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay2}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding DataContext.PriorDay2Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    AutomationProperties.Name="{Binding DataContext.PriorDay2Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.PriorDay2SortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay2}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay2Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay3}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding DataContext.PriorDay3Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    AutomationProperties.Name="{Binding DataContext.PriorDay3Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.PriorDay3SortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay3}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay3Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShareAnalyticsSortCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SortColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 Value="{x:Static analytics:AccountShareSortColumn.PriorDay4}">
                                        <Setter Property="Background" Value="{StaticResource ShareAnalyticsSortedCellBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding DataContext.PriorDay4Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    AutomationProperties.Name="{Binding DataContext.PriorDay4Header, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Style="{StaticResource ShareAnalyticsSortButtonStyle}"
                                    Tag="{Binding DataContext.PriorDay4SortGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{x:Static analytics:AccountShareSortColumn.PriorDay4}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PriorDay4Text}" TextAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="76">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="链接" AutomationProperties.Name="链接"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="打开" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="260">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="标题" AutomationProperties.Name="标题"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                           Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="90">
                        <DataGridTemplateColumn.Header>
                            <Grid>
                                <TextBlock Text="状态" AutomationProperties.Name="状态"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BaiduBatchTransfer.App.Features.Collect.CollectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 只对模糊模式有意义的控件，精准模式下淡化 -->
        <Style x:Key="FuzzyOnlyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.45" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFuzzyMode}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 采集参数 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource MutedBrush}"
                           Text="按关键词在百度知道里找带网盘链接的回答，提取资源名、链接与提取码。采到的结果可直接送进批量转存。" />

                <!-- 关键词与 Cookie 并排等宽 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="关键词（每行一个）" Margin="0,0,0,6"
                               Foreground="{StaticResource MutedBrush}" />

                    <!-- 空白时给出示例，避免一个不知道填什么的空框 -->
                    <Grid Grid.Row="1">
                        <TextBox x:Name="KeywordBox"
                                 Text="{Binding KeywordText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Height="104" Padding="2,6"
                                 IsEnabled="{Binding CanEditTask}"
                                 ToolTip="{Binding KeywordInputHint}" />
                        <!-- 占位提示。Margin 是量出来的，不是算出来的：
                             用 UI 自动化读到真实文本落在框左上角偏移 (7,13) 处，
                             只读 TextBox 的内部渲染和可编辑的差 (2,6)，对不齐，故改回 TextBlock。
                             注意：改 Padding 或字号后这两个数要重新量。 -->
                        <TextBlock IsHitTestVisible="False" Margin="7,13,0,0" Opacity="0.5"
                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="每行一个关键词，例如：云边有个小卖部">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeywordText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="知道账号 Cookie" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="仅在本机使用，不写入日志与结果文件。" Margin="8,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" Opacity="0.75"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Height="104" Padding="2,6"
                             ToolTip="登录 zhidao.baidu.com 后复制完整 Cookie。只在本机使用，不会写入日志或结果文件。" />
                    <Button Grid.Row="2" Content="从文件导入…" Padding="12,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding ImportKeywordsCommand}"
                            Visibility="{Binding CanImportKeywords, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="支持 Excel (.xlsx)、CSV、TSV、TXT；自动识别关键词列，去重后追加，当前批次最多 10000 个关键词" />

                    <Button Grid.Row="2" Grid.Column="2" Content="验证 Cookie"
                            Command="{Binding ValidateCookieCommand}"
                            Padding="12,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                            ToolTip="查询知道账号登录状态，无需填写关键词" />
                </Grid>

                <!-- 模式与目标条数：目标条数只对模糊模式有意义，精准时置灰 -->
                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <RadioButton DockPanel.Dock="Left" Content="精准：每词一条"
                                 IsChecked="{Binding IsPreciseMode}" VerticalAlignment="Center"
                                 IsEnabled="{Binding CanEditTask}"
                                 ToolTip="每个关键词各采一条，最省账号" />
                    <RadioButton DockPanel.Dock="Left" Content="模糊：采够为止" Margin="20,0,0,0"
                                 IsChecked="{Binding IsFuzzyMode}" VerticalAlignment="Center"
                                 IsEnabled="{Binding CanEditTask}"
                                 ToolTip="围绕关键词扩展搜索，直到采够目标条数" />
                    <TextBox DockPanel.Dock="Right" Width="70" VerticalAlignment="Center"
                             Text="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditTargetCount}" />
                    <TextBlock DockPanel.Dock="Right" Text="目标条数" Margin="0,0,8,0"
                               Style="{StaticResource FuzzyOnlyLabel}" />
                </DockPanel>

                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="开始采集" Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <!-- 暂停会保存进度，之后（包括重开软件后）可接着采；停止则结束本次任务 -->
                    <Button DockPanel.Dock="Left" Content="{Binding PauseButtonText}"
                            Command="{Binding PauseResumeCommand}" Margin="8,0,0,0"
                            ToolTip="暂停会保存进度，之后可点「继续」接着采，关闭软件后再打开也可以" />
                    <Button DockPanel.Dock="Left" Content="停止" Command="{Binding StopCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 风控提示：采集此刻正阻塞等待选择，平时折叠不占位 -->
        <Border Grid.Row="1" Background="{StaticResource WarningRowBrush}" CornerRadius="4"
                Padding="14,10" Margin="0,10,0,0"
                Visibility="{Binding IsRiskPromptVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="停止采集" Margin="8,0,0,0"
                        Command="{Binding AbortAfterRiskCommand}" />
                <Button DockPanel.Dock="Right" Content="换好了，继续" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ContinueAfterRiskCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RiskReason}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="采集遇到账号限制，正在等你选择。换个网络节点后可继续，也可以就此停止。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 采集结果 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="采集结果" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="已采" />
                        <Run Text="{Binding FoundCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="/" />
                        <Run Text="{Binding TargetTotal, Mode=OneWay}" />
                        <Run Text="条" />
                    </TextBlock>
                    <ProgressBar Height="6" Margin="14,0,0,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="{Binding TargetTotal}"
                                 Value="{Binding FoundCount, Mode=OneWay}" />
                </DockPanel>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="复制链接" Command="{Binding CopyLinksCommand}" Margin="0,0,8,0" />
                    <Button Content="导出 Excel" Command="{Binding ExportResultsCommand}" Margin="0,0,8,0" />
                    <Button Content="送入批量转存" Command="{Binding SendToTransferCommand}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ResultScopeText}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" ToolTip="按住 Ctrl 或 Shift 可多选；未选中时操作全部结果。" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultActionMessage}" ToolTip="{Binding ResultActionMessage}"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultActionMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 日志保留独立滚动区域，给结果操作留出空间。 -->
                <DockPanel DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="11" Margin="0,0,0,2"
                               Foreground="{StaticResource MutedBrush}" />
                    <ListBox x:Name="RunLogList" ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent"
                             FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Resources}" Style="{StaticResource DenseDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="56" />
                        <DataGridTextColumn Header="资源名称" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                        <DataGridTextColumn Header="资源链接" Binding="{Binding Link}" Width="3*" MinWidth="180" />
                        <DataGridTextColumn Header="提取码" Binding="{Binding Pwd}" Width="80" />
                        <!-- 来源保留原帖链接：可疑资源要能点回去看是谁发的 -->
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="2*" MinWidth="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

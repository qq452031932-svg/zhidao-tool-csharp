<UserControl x:Class="BaiduBatchTransfer.App.Features.Collect.CollectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 采集参数 -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="110" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2">
                    <TextBlock Text="知道采集" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="按关键词在百度知道里找带网盘链接的回答，提取资源名、链接与提取码。采到的结果可直接送进批量转存。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" TextWrapping="Wrap" />
                </StackPanel>

                <TextBox Grid.Row="1" Text="{Binding KeywordText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         ToolTip="每行一个关键词，也可以用逗号分隔" />

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="知道账号 Cookie" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"
                             Height="52" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" Margin="0,4,0,0"
                             ToolTip="登录 zhidao.baidu.com 后复制完整 Cookie。只在本机使用，不会写入日志或结果文件。" />
                    <TextBlock Text="仅在本机使用，不写入日志与结果文件。"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton Content="精准（按词各采一条）" IsChecked="{Binding IsPreciseMode}"
                                 VerticalAlignment="Center" />
                    <RadioButton Content="模糊（采够数量为止）" IsChecked="{Binding IsFuzzyMode}"
                                 VerticalAlignment="Center" Margin="16,0,0,0" />
                    <TextBlock Text="目标条数" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}" Width="70"
                             VerticalAlignment="Center"
                             IsEnabled="{Binding IsFuzzyMode}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="开始采集" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="停止" Command="{Binding StopCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 风控提示：采集此刻正阻塞等待选择 -->
        <Border Grid.Row="1" Background="{StaticResource WarningRowBrush}" CornerRadius="4"
                Padding="12,10" Margin="0,8,0,0"
                Visibility="{Binding IsRiskPromptVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RiskReason}" FontWeight="SemiBold" />
                    <TextBlock Text="采集已暂停。换个网络节点后可继续，也可以就此停止。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="换好了，继续" Command="{Binding ContinueAfterRiskCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="停止采集" Command="{Binding AbortAfterRiskCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 采集结果 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="96" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="采集结果" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="已采" />
                        <Run Text="{Binding FoundCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="/" />
                        <Run Text="{Binding TargetTotal, Mode=OneWay}" />
                        <Run Text="条" />
                    </TextBlock>
                    <ProgressBar Width="180" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="{Binding TargetTotal}" Value="{Binding FoundCount, Mode=OneWay}" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Resources}" Style="{StaticResource DenseDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Ordinal}" Width="56" />
                        <DataGridTextColumn Header="资源名称" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="资源链接" Binding="{Binding Link}" Width="3*" />
                        <DataGridTextColumn Header="提取码" Binding="{Binding Pwd}" Width="80" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="运行日志" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                    <ListBox ItemsSource="{Binding Logs}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

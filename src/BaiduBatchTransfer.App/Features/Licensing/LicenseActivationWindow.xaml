<Window x:Class="BaiduBatchTransfer.App.Features.Licensing.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProductName}"
        Width="520"
        Height="430"
        MinWidth="520"
        MinHeight="430"
        Background="#EDF4F2"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Border Background="White"
                BorderBrush="#D6E5E1"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="112" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#0F9D8A"
                        CornerRadius="11,11,0,0"
                        Padding="30,22">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="知道综合工具"
                                   Foreground="White"
                                   FontSize="25"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="软件授权"
                                   Margin="0,6,0,0"
                                   Foreground="#D9FFF7"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="30,24,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="请输入卡密"
                               Foreground="#173B36"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Height="48"
                             Margin="0,8,0,0"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             BorderBrush="#AACBC4"
                             BorderThickness="1"
                             FontSize="15"
                             Text="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="卡密输入" />
                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="#647773"
                               FontSize="12"
                               Text="卡密将绑定当前电脑，请确认后激活"
                               TextWrapping="Wrap" />
                    <Border Grid.Row="3"
                            MinHeight="44"
                            Margin="0,15,0,16"
                            Padding="12,10"
                            VerticalAlignment="Top"
                            Background="#F3F8F7"
                            BorderBrush="#D6E5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#365A53"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="授权状态" />
                    </Border>
                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="暂不激活"
                                Width="104"
                                Height="40"
                                Background="White"
                                BorderBrush="#9CB9B3"
                                Foreground="#365A53"
                                Command="{Binding CloseCommand}"
                                IsCancel="True"
                                AutomationProperties.Name="暂不激活" />
                        <Button Content="{Binding ActivateButtonText}"
                                Width="112"
                                Height="40"
                                Margin="12,0,0,0"
                                Background="#0F9D8A"
                                BorderBrush="#0F9D8A"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Command="{Binding ActivateCommand}"
                                IsDefault="True"
                                AutomationProperties.Name="立即激活" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="BaiduBatchTransfer.App.Features.Licensing.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProductName}"
        Width="520"
        Height="430"
        MinWidth="360"
        MinHeight="280"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ActivationCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6E5E1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#00796B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderSubtitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#D9FFF7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00796B" />
            <Setter Property="BorderBrush" Value="#00796B" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationSecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9CB9B3" />
            <Setter Property="Foreground" Value="#365A53" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationBodyLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#173B36" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationBodyHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#647773" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderBrush" Value="#AACBC4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="CaretBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="SelectionBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="SelectionTextBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationStatusRegionStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F3F8F7" />
            <Setter Property="BorderBrush" Value="#D6E5E1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationStatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#365A53" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="{x:Type Window}"
               BasedOn="{StaticResource {x:Type Window}}">
            <Setter Property="Background" Value="#EDF4F2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid Margin="28">
        <Border Style="{StaticResource ActivationCardStyle}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ActivationHeader"
                        Style="{StaticResource ActivationHeaderStyle}"
                        MinHeight="112"
                        CornerRadius="11,11,0,0"
                        Padding="30,22">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}"
                                   Style="{StaticResource ActivationHeaderTitleStyle}"
                                   FontSize="25"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="软件授权"
                                   Style="{StaticResource ActivationHeaderSubtitleStyle}"
                                   Margin="0,6,0,0"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ActivationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid x:Name="ActivationBody" Margin="30,24,30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CardLabel"
                                   Style="{StaticResource ActivationBodyLabelStyle}"
                                   Text="请输入卡密"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="CardInput"
                             Style="{StaticResource ActivationTextBoxStyle}"
                             Grid.Row="1"
                             Height="48"
                             Margin="0,8,0,0"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             BorderThickness="1"
                             FontSize="15"
                             Text="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="卡密输入" />
                        <TextBlock x:Name="CardExampleHint"
                               Style="{StaticResource ActivationBodyHintStyle}"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Text="示例：XXXX-XXXX-XXXX"
                               AutomationProperties.Name="卡密格式示例：XXXX-XXXX-XXXX" />
                        <TextBlock x:Name="CardBindingHint"
                               Style="{StaticResource ActivationBodyHintStyle}"
                               Grid.Row="3"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Text="卡密将绑定当前电脑，请确认后激活"
                               TextWrapping="Wrap" />
                        <Border x:Name="ActivationStatusRegion"
                            Style="{StaticResource ActivationStatusRegionStyle}"
                            Grid.Row="4"
                            MinHeight="44"
                            Margin="0,15,0,16"
                            Padding="12,10"
                            VerticalAlignment="Top"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock x:Name="ActivationStatusText"
                                   Style="{StaticResource ActivationStatusTextStyle}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="授权状态" />
                        </Border>
                        <StackPanel Grid.Row="5"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Style="{StaticResource ActivationSecondaryButtonStyle}"
                                Content="暂不激活"
                                MinWidth="104"
                                MinHeight="40"
                                Padding="14,8"
                                Command="{Binding CloseCommand}"
                                IsCancel="True"
                                AutomationProperties.Name="暂不激活" />
                        <Button x:Name="ActivateButton"
                                Style="{StaticResource ActivationPrimaryButtonStyle}"
                                Content="{Binding ActivateButtonText}"
                                MinWidth="112"
                                MinHeight="40"
                                Padding="14,8"
                                Margin="12,0,0,0"
                                FontWeight="SemiBold"
                                Command="{Binding ActivateCommand}"
                                IsDefault="True"
                                AutomationProperties.Name="{Binding ActivateButtonText}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="BaiduBatchTransfer.App.Features.Licensing.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProductName}" Icon="{DynamicResource ProductWindowIcon}"
        Width="560"
        Height="500"
        MinWidth="360"
        MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}">
            <Setter Property="Background" Value="#F4F6F8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <!-- 深色玻璃卡片。品牌色与对比度在 LicenseActivationViewStructureTests 中有断言：
             正文与背景的对比度必须 ≥ 4.5，高对比度模式必须改用系统画刷。 -->
        <Style x:Key="ActivationCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6EBEF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#111827" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationHeaderSubtitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#65747E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="BorderBrush" Value="#0D9488" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationSecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DCE2" />
            <Setter Property="Foreground" Value="#41525C" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationBodyLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#1A2B33" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationBodyHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#65747E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="Foreground" Value="#1A2B33" />
            <Setter Property="BorderBrush" Value="#D5DCE2" />
            <Setter Property="CaretBrush" Value="#0D9488" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#0D9488" />
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="CaretBrush"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="SelectionBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="SelectionTextBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationStatusRegionStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F7F9FB" />
            <Setter Property="BorderBrush" Value="#E6EBEF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 状态区专用：与示例面板外观一致，但没有状态文字时整块隐藏，
             否则弹窗中部会留下一个没有任何说明的空框。 -->
        <Style x:Key="ActivationStatusBoxStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource ActivationStatusRegionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivationStatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#1A2B33" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource ActivationCardStyle}"
                VerticalAlignment="Center"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ActivationHeader"
                        Style="{StaticResource ActivationHeaderStyle}"
                        CornerRadius="16,16,0,0"
                        Padding="30,16,30,6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="软件授权"
                                   Style="{StaticResource ActivationHeaderTitleStyle}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProductName}"
                                   Style="{StaticResource ActivationHeaderSubtitleStyle}"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ActivationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid x:Name="ActivationBody" Margin="30,12,30,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CardLabel"
                                   Style="{StaticResource ActivationBodyLabelStyle}"
                                   Text="请输入卡密"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="CardInput"
                                 Style="{StaticResource ActivationTextBoxStyle}"
                                 Grid.Row="1"
                                 Height="48"
                                 Margin="0,8,0,0"
                                 Padding="14,8"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="1"
                                 FontSize="16"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 Text="{Binding Card, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="卡密输入" />
                        <Border Grid.Row="2"
                                Style="{StaticResource ActivationStatusRegionStyle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,8,0,0"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CardExampleHint"
                                           Style="{StaticResource ActivationBodyHintStyle}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Text="示例：ABCD2345-EFGH6723-JKLM4567-NPQR2345（4 组，每组 8 位）"
                                           AutomationProperties.Name="卡密格式示例：4 组，每组 8 位，用横线分隔" />
                                <TextBlock x:Name="CardProgressHint"
                                           Grid.Column="1"
                                           Style="{StaticResource ActivationBodyHintStyle}"
                                           FontSize="12"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CardProgressHint}"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="卡密输入进度" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CardBindingHint"
                                   Style="{StaticResource ActivationBodyHintStyle}"
                                   Grid.Row="3"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="卡密将绑定当前电脑，请确认后激活" />
                        <Border x:Name="ActivationStatusRegion"
                                Style="{StaticResource ActivationStatusBoxStyle}"
                                Grid.Row="4"
                                MinHeight="44"
                                Margin="0,10,0,10"
                                Padding="12,8"
                                VerticalAlignment="Top"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock x:Name="ActivationStatusText"
                                       Style="{StaticResource ActivationStatusTextStyle}"
                                       Text="{Binding StatusMessage}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="授权状态" />
                        </Border>
                        <!-- 单行动作区：在 520x430 的下限里两个按钮都必须完整可见，
                             这一约束由 ActivationWindowKeepsActionsVisibleOrScrollAccessibleWhenSpaceShrinks 断言。 -->
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ContactHint"
                                       Style="{StaticResource ActivationBodyHintStyle}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="{Binding ContactHintText}"
                                       AutomationProperties.Name="联系方式" />
                            <Button x:Name="CancelButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ActivationSecondaryButtonStyle}"
                                    Content="暂不激活"
                                    MinWidth="96"
                                    MinHeight="42"
                                    Margin="10,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding CloseCommand}"
                                    IsCancel="True"
                                    AutomationProperties.Name="暂不激活" />
                            <Button x:Name="ActivateButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ActivationPrimaryButtonStyle}"
                                    Content="{Binding ActivateButtonText}"
                                    MinWidth="140"
                                    MinHeight="42"
                                    Margin="10,0,0,0"
                                    Padding="16,8"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Command="{Binding ActivateCommand}"
                                    IsDefault="True"
                                    AutomationProperties.Name="{Binding ActivateButtonText}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

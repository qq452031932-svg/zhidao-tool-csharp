<UserControl x:Class="BaiduBatchTransfer.App.Features.Jobs.JobResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="任务结果">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="资源：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding ResourceCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="操作：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding OperationCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="失败：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding FailedCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="暂停：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding PausedCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                </WrapPanel>
                <TextBlock Text="{Binding TransferCapabilityMessage}" Foreground="#8A5A00" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ShareCapabilityMessage}" Foreground="#8A5A00" />
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding CandidateSequence}" Width="80" />
                <DataGridTextColumn Header="标题" Binding="{Binding ResolvedTitle}" Width="2*" />
                <DataGridTextColumn Header="账号" Binding="{Binding AccountDisplayName}" Width="*" />
                <DataGridTextColumn Header="转存状态" Binding="{Binding TransferStatusText}" Width="120" />
                <DataGridTextColumn Header="分享状态" Binding="{Binding ShareStatusText}" Width="120" />
                <DataGridTextColumn Header="转存错误码" Binding="{Binding TransferErrorCode}" Width="120" />
                <DataGridTextColumn Header="分享错误码" Binding="{Binding ShareErrorCode}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel KeyboardNavigation.TabNavigation="Local">
                <Button Content="下一页" Command="{Binding LoadNextPageCommand}" />
                <Button Content="刷新结果" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                <Button Content="仅重试分享" Command="{Binding RetryShareOnlyCommand}" Margin="8,0,0,0" />
                <Button Content="确认转存结果" Command="{Binding ReconcileTransferCommand}" Margin="8,0,0,0" />
                <Button Content="确认分享结果" Command="{Binding ReconcileShareCommand}" Margin="8,0,0,0" />
                <Button Content="恢复转存" Command="{Binding ResumeTransferCommand}" Margin="8,0,0,0" />
                <Button Content="恢复分享" Command="{Binding ResumeShareCommand}" Margin="8,0,0,0" />
                <Button Content="处理已有分享" Command="{Binding ResolveExistingSharesCommand}" Margin="8,0,0,0" />
                <Button Content="另存结果表格" Command="{Binding SaveAsCommand}" Margin="8,0,0,0" />
                <Button Content="取消另存" Command="{Binding CancelSaveCommand}" Margin="8,0,0,0" />
            </WrapPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding StatusMessage}" />
                <TextBlock Text="  已写入：" Margin="16,0,0,0" />
                <TextBlock Text="{Binding ExportedRows, StringFormat={}{0:N0}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

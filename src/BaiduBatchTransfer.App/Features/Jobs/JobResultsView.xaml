<UserControl x:Class="BaiduBatchTransfer.App.Features.Jobs.JobResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="任务结果">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 四个计数字不值得包一张带边框的卡片：那层边框加内边距把一行字
             撑成了近 50 像素，而这些垂直空间本该给下面的结果表格。 -->
        <Border Padding="2,0" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="资源：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding ResourceCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="操作：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding OperationCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="失败：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding FailedCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="暂停：" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding PausedCount, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  Style="{StaticResource DenseDataGridStyle}" RowHeight="34" ColumnHeaderHeight="38"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionMode="Single">
            <DataGrid.Columns>
                <!-- 短内容列按内容自适应，长文本列按比例并设最小宽度：原先 440px 的固定列
                     吃掉了大部分宽度，标题与链接被压到几十像素而截断。 -->
                <DataGridTextColumn Header="序号" Binding="{Binding CandidateSequence}" Width="Auto" MinWidth="56" />
                <DataGridTextColumn Header="标题" Binding="{Binding ResolvedTitle}" Width="2*" MinWidth="140" />
                <DataGridTextColumn Header="账号" Binding="{Binding AccountDisplayName}" Width="Auto" MinWidth="88" />
                <DataGridTextColumn Header="原链接" Binding="{Binding OriginalShareUrl}" Width="2*" MinWidth="160" />
                <DataGridTextColumn Header="百度保存目录" Binding="{Binding TargetPath}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="转存状态" Binding="{Binding TransferStatusText}" Width="Auto" MinWidth="84" />
                <DataGridTextColumn Header="转存提示" Binding="{Binding TransferDetailMessage}" Width="2*" MinWidth="140" />
                <DataGridTextColumn Header="分享状态" Binding="{Binding ShareStatusText}" Width="Auto" MinWidth="84" />
                <DataGridTextColumn Header="新分享链接" Binding="{Binding GeneratedShareUrl}" Width="2*" MinWidth="160" />
                <DataGridTextColumn Header="新提取码" Binding="{Binding GeneratedExtractionCode}" Width="Auto" MinWidth="88" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel KeyboardNavigation.TabNavigation="Local">
                <Button Content="下一页" Command="{Binding LoadNextPageCommand}" />
                <Button Content="刷新结果" Command="{Binding RefreshCommand}" Margin="10,0,0,10" />
                <Button Content="选中失败" Command="{Binding SelectFailedCommand}" Margin="10,0,0,10" />
                <Button Content="清除选择" Command="{Binding ClearSelectionCommand}" Margin="10,0,0,10" />
                <Button Content="复制链接和提取码" Command="{Binding CopyGeneratedShareCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}" Margin="10,0,0,10" />
                <Button Content="另存结果表格" Command="{Binding SaveAsCommand}" Margin="10,0,0,10" />
                <Menu VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="更多">
                        <MenuItem Header="重试分享" Command="{Binding RetryShareOnlyCommand}" />
                        <MenuItem Header="继续转存" Command="{Binding ResumeTransferCommand}" />
                        <MenuItem Header="继续分享" Command="{Binding ResumeShareCommand}" />
                        <Separator />
                        <MenuItem Header="检查转存结果" Command="{Binding ReconcileTransferCommand}" />
                        <MenuItem Header="检查分享结果" Command="{Binding ReconcileShareCommand}" />
                        <MenuItem Header="处理已有分享" Command="{Binding ResolveExistingSharesCommand}" />
                        <Separator />
                        <MenuItem Header="取消另存" Command="{Binding CancelSaveCommand}" />
                    </MenuItem>
                </Menu>
            </WrapPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding StatusMessage}" />
                <TextBlock Text="  已写入：" Margin="16,0,0,0" />
                <TextBlock Text="{Binding ExportedRows, StringFormat={}{0:N0}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

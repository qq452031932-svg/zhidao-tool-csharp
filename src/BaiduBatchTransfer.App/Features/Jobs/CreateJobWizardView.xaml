<UserControl x:Class="BaiduBatchTransfer.App.Features.Jobs.CreateJobWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:BaiduBatchTransfer.Core.Domain;assembly=BaiduBatchTransfer.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="16" Padding="12,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text=" · 已跳过" Foreground="{StaticResource MutedBrush}"
                                               Visibility="{Binding IsSkipped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsImportStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="1. 导入结果与转存模式" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="只有一个可用账号时会自动选中，但仍需在最后确认；多个账号必须明确选择模式。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                    <WrapPanel>
                        <Button Content="多账号复制" Command="{Binding SelectReplicationCommand}" />
                        <Button Content="多账号分流" Command="{Binding SelectDistributionCommand}" />
                        <CheckBox Content="需要批量预检" IsChecked="{Binding UseBulkPrecheck}" VerticalAlignment="Center" Margin="12,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AccountSelectionNotice}" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsPrecheckStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="2. 批量预检" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="创建任务前批量检查链接有效性" IsChecked="{Binding UseBulkPrecheck}" Margin="0,12,0,8" />
                    <TextBlock Text="预检固定使用一个明确选择的账号；登录或安全验证暂停后仍使用该账号继续。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName" SelectedValuePath="AccountId"
                              SelectedValue="{Binding PrecheckAccountId}" Margin="0,10,0,8" Width="280" HorizontalAlignment="Left" />
                    <Button Content="开始或继续预检" Command="{Binding RunPrecheckCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding PrecheckStatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsDestinationStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="3. 任务与目录" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="任务名称" Margin="0,10,0,5" />
                        <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="默认目标目录" Margin="0,10,0,5" />
                        <TextBox Text="{Binding DefaultTargetPath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="建目录方式" Margin="0,10,0,5" />
                        <WrapPanel>
                            <Button Content="保持原结构" Command="{Binding PreserveStructureCommand}" />
                            <Button Content="创建外层文件夹" Command="{Binding CreateOuterFolderCommand}" />
                        </WrapPanel>
                        <TextBlock Text="同名处理" Margin="0,10,0,5" />
                        <WrapPanel>
                            <Button Content="跳过同名项" Command="{Binding SkipDuplicateCommand}" />
                            <Button Content="自动重命名" Command="{Binding RenameDuplicateCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Excel 逐行账号处理" FontWeight="SemiBold" />
                        <TextBlock Text="复制模式只能忽略账号列；分流模式可保留映射或统一覆盖。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10" />
                        <WrapPanel>
                            <Button Content="保留已匹配账号" Command="{Binding KeepExcelMappingsCommand}" />
                            <Button Content="自动匹配唯一名称" Command="{Binding AutoMapUniqueExcelAccountsCommand}" />
                            <Button Content="统一覆盖全部记录" Command="{Binding OverrideExcelMappingsCommand}" />
                            <Button Content="复制时忽略账号列" Command="{Binding IgnoreExcelAccountColumnCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsAllocationStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="4. 账号与配额" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10,0,10">
                        <Button Content="按任务数量" Command="{Binding UseTaskQuotaCommand}" />
                        <Button Content="按成功数量补足" Command="{Binding UseSuccessTargetCommand}" />
                        <Button Content="平均分配" Command="{Binding ApplyEqualAllocationCommand}" />
                        <Button Content="按剩余容量分配" Command="{Binding ApplyCapacityAllocationCommand}" />
                        <Button Content="快捷分配 1:2:1" Command="{Binding ApplyOneTwoOneCommand}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="参与" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                            <DataGridCheckBoxColumn Header="生成分享" Binding="{Binding ShareEnabled, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="账号" Binding="{Binding DisplayName}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="剩余容量" Binding="{Binding RemainingCapacity}" IsReadOnly="True" Width="105" />
                            <DataGridTextColumn Header="任务配额" Binding="{Binding TargetItemCount, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            <DataGridTextColumn Header="成功目标" Binding="{Binding TargetSuccessCount, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            <DataGridTextColumn Header="原目标" Binding="{Binding OriginalTargetSuccessCount}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="有效目标" Binding="{Binding EffectiveTargetSuccessCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="可达目标" Binding="{Binding ReachableTargetSuccessCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="已满足" Binding="{Binding FulfilledCount}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="占位中" Binding="{Binding ReservedSlotCount}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="锁定" Binding="{Binding LockedItemCount}" IsReadOnly="True" Width="65" />
                            <DataGridTextColumn Header="专属候选" Binding="{Binding ExclusiveCandidateCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="公共候选" Binding="{Binding PublicCandidateCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="未用专属" Binding="{Binding UnusedExclusiveCandidateCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="预计缺口" Binding="{Binding ShortfallCount}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="目标目录" Binding="{Binding DefaultTargetPath, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Header="分享设置" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <WrapPanel>
                                <TextBlock Text="有效期：" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ShareValidityText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <TextBlock Text="访问次数：" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ShareAccessText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="提取码：" VerticalAlignment="Center" />
                                <ComboBox SelectedValue="{Binding ExtractionCodeBehavior}" SelectedValuePath="Tag" Width="130">
                                    <ComboBoxItem Content="随机提取码" Tag="{x:Static domain:ShareExtractionCodeBehavior.Random}" />
                                    <ComboBoxItem Content="固定提取码" Tag="{x:Static domain:ShareExtractionCodeBehavior.Fixed}" />
                                </ComboBox>
                                <TextBox Text="{Binding FixedExtractionCode, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesFixedExtractionCode}" Width="100" Margin="8,0,18,0" />
                                <TextBlock Text="已有分享：" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ExistingSharePolicyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ShareCapabilityStatusMessage}" Foreground="#B54708"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="资源不足策略：" VerticalAlignment="Center" />
                        <Button Content="按比例缩减" Command="{Binding UseProportionalReductionCommand}" />
                        <Button Content="账号优先级" Command="{Binding UseAccountPriorityCommand}" />
                        <Button Content="暂停等待补充" Command="{Binding UseWaitForCandidatesCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding WarningMessage}" Foreground="#B54708" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsConfirmationStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="280" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="5. 分页核对" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="（只加载当前页，不会把全部资源放入内存）" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Binding="{Binding SourceRowNumber}" Width="75" />
                            <DataGridTextColumn Header="分享链接" Binding="{Binding ShareUrl}" Width="*" />
                            <DataGridTextColumn Header="提取码" Binding="{Binding ExtractionCode}" Width="90" />
                            <DataGridTextColumn Header="账号" Binding="{Binding RequestedAccountName}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding DispositionText}" Width="110" />
                            <DataGridTextColumn Header="预检" Binding="{Binding PrecheckText}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2">
                        <Button Content="刷新第一页" Command="{Binding LoadFirstPreviewPageCommand}" />
                        <Button Content="下一页" Command="{Binding LoadNextPreviewPageCommand}" />
                        <TextBlock Text="{Binding PreviewTotalCount, StringFormat=共 {0:N0} 条}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsConfirmationStepVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="5. 最终确认" FontSize="18" FontWeight="SemiBold" />
                    <UniformGrid Columns="3" Margin="0,12,0,8">
                        <TextBlock Text="{Binding TransferModeText, StringFormat=转存模式：{0}}" />
                        <TextBlock Text="{Binding QuotaBasisText, StringFormat=分配依据：{0}}" />
                        <TextBlock Text="{Binding ShortagePolicyText, StringFormat=不足策略：{0}}" />
                        <TextBlock Text="{Binding ValidationModeText, StringFormat=检测方式：{0}}" />
                        <TextBlock Text="{Binding FolderCreationModeText, StringFormat=目录方式：{0}}" />
                        <TextBlock Text="{Binding DuplicatePolicyText, StringFormat=同名处理：{0}}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding DefaultTargetPath, StringFormat=默认目标目录：{0}}" TextWrapping="Wrap" />
                    <UniformGrid Columns="4" Margin="0,12,0,8">
                        <TextBlock Text="{Binding ConfirmedResourceCount, StringFormat=确认资源：{0:N0}}" />
                        <TextBlock Text="{Binding TransferCount, StringFormat=转存操作：{0:N0}}" />
                        <TextBlock Text="{Binding ShareCount, StringFormat=分享操作：{0:N0}}" />
                        <TextBlock Text="{Binding TotalActionCount, StringFormat=总操作：{0:N0}}" />
                        <TextBlock Text="{Binding ResultColumnCount, StringFormat=结果列：{0:N0}}" />
                        <TextBlock Text="{Binding ConfirmedOperationCount, StringFormat=确认转存：{0:N0}}" />
                        <TextBlock Text="{Binding AssignedCount, StringFormat=已分配：{0:N0}}" />
                        <TextBlock Text="{Binding ReserveCandidateCount, StringFormat=候补资源：{0:N0}}" />
                    </UniformGrid>
                    <TextBlock Text="已选账号与权威工作量" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <DataGrid ItemsSource="{Binding ConfirmationAccounts}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MaxHeight="190" EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="转存" Binding="{Binding ConfirmedTransferCount}" Width="100" />
                            <DataGridTextColumn Header="分享" Binding="{Binding ConfirmedShareCount}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding RequiredFreeBytes, StringFormat=预计需要本机空间：{0:N0} 字节}" />
                    <TextBlock Text="{Binding AvailableFreeBytes, StringFormat=当前可用本机空间：{0:N0} 字节}" Margin="0,3,0,8" />
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#B42318" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AdapterStatusMessage}" Foreground="#B54708" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <CheckBox Content="我已核对模式、账号、配额、目录、同名策略、检测方式和资源不足策略"
                              IsChecked="{Binding IsFinalConfirmationChecked}" Margin="0,12,0,12" />
                    <WrapPanel>
                        <Button Content="生成最终预览" Command="{Binding PrepareConfirmationCommand}" />
                        <Button Content="确认创建任务" Command="{Binding CreateJobCommand}" Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                <DockPanel>
                    <Button Content="上一步" Command="{Binding PreviousStepCommand}" DockPanel.Dock="Left" />
                    <Button Content="下一步" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

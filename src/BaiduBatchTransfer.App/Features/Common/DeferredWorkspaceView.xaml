<UserControl x:Class="BaiduBatchTransfer.App.Features.Common.DeferredWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="240">
    <Border Style="{StaticResource BorderedPanelStyle}">
        <Grid>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <Border Width="48" Height="48"
                        HorizontalAlignment="Center"
                        Background="{StaticResource NavSelectedBrush}"
                        CornerRadius="24">
                    <TextBlock Text="…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrandBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding ModuleName}"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

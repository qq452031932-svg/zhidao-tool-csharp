    <AssemblyName>$(ProductMainAssemblyName)</AssemblyName>
    <AssemblyTitle>$(ProductDisplayName)</AssemblyTitle>
    <Product>$(ProductDisplayName)</Product>
    <Description>$(ProductDescription)</Description>
    <LicenseProductId Condition="'$(LicenseProductId)' == ''">$(ProductLicenseProductId)</LicenseProductId>
    <LicenseSigningKeyId Condition="'$(LicenseSigningKeyId)' == ''">production-v1</LicenseSigningKeyId>
    <LicenseAcceptanceBuild Condition="'$(LicenseAcceptanceBuild)' == ''">false</LicenseAcceptanceBuild>

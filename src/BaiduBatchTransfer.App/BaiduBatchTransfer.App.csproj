    <_ExpectedProductVersion>$(VersionPrefix)</_ExpectedProductVersion>
    <_ExpectedInformationalVersion>$(VersionPrefix)</_ExpectedInformationalVersion>
    <_ExpectedFileVersion>$(VersionPrefix).0</_ExpectedFileVersion>
    <Version>$(_ExpectedProductVersion)</Version>
    <InformationalVersion>$(_ExpectedInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>$(_ExpectedFileVersion)</FileVersion>
    <_VersionPrefixIsValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(VersionPrefix)', '^(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-4])\.(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-4])\.(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-4])$'))</_VersionPrefixIsValid>
    <_ExpectedProductMajor Condition="'$(_VersionPrefixIsValid)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(VersionPrefix)', '^([0-9]+)\..*$', '$1'))</_ExpectedProductMajor>
    <_ExpectedProductMajor Condition="'$(_ExpectedProductMajor)' == ''">0</_ExpectedProductMajor>
    <_ExpectedAssemblyVersion>$(_ExpectedProductMajor).0.0.0</_ExpectedAssemblyVersion>
    <ProductMajor>$(_ExpectedProductMajor)</ProductMajor>
    <AssemblyVersion>$(_ExpectedAssemblyVersion)</AssemblyVersion>
    <OtaAcceptanceBuild Condition="'$(OtaAcceptanceBuild)' == ''">false</OtaAcceptanceBuild>
    <PackageId Condition="'$(PackageId)' == '' and '$(OtaAcceptanceBuild)' == 'true'">SuperPan.BaiduBatchTransfer.OtaAcceptance</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">$(ProductPackageId)</PackageId>
    <UpdateChannel Condition="'$(UpdateChannel)' == ''">win-x64-stable</UpdateChannel>
    <AdapterBuildVersion Condition="'$(AdapterBuildVersion)' == ''">managed-browser-v3</AdapterBuildVersion>
    <ManagedBrowserHelperPackageDirectory Condition="'$(ManagedBrowserHelperPackageDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\.artifacts\managed-session-pipeline-20260901\helper-bundle-r2</ManagedBrowserHelperPackageDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <_UpdateFeedUrlIsValid Condition="'$(UpdateFeedUrl)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(UpdateFeedUrl)', '(?i)^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*(?::(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^?#\s]*)?$'))</_UpdateFeedUrlIsValid>
    <_UpdateFeedUrlIsApprovedProduction>False</_UpdateFeedUrlIsApprovedProduction>
    <_UpdateFeedUrlIsApprovedProduction Condition="'$(UpdateFeedUrl)' == 'https://ota.fanfh.cn/releases/win-x64/stable/'">True</_UpdateFeedUrlIsApprovedProduction>
    <_AcceptanceFeedIsAbsolute Condition="'$(OtaAcceptanceFeedPath)' != ''">$([System.IO.Path]::IsPathFullyQualified('$(OtaAcceptanceFeedPath)'))</_AcceptanceFeedIsAbsolute>
    <_LicenseServiceUrlIsAcceptanceLoopback Condition="'$(LicenseServiceUrl)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(LicenseServiceUrl)', '^http://127\.0\.0\.1(?::[0-9]{1,5})?/?$'))</_LicenseServiceUrlIsAcceptanceLoopback>
    <_LicenseAcceptanceConfigIsAbsolute Condition="'$(LicenseAcceptanceConfigPath)' != ''">$([System.IO.Path]::IsPathFullyQualified('$(LicenseAcceptanceConfigPath)'))</_LicenseAcceptanceConfigIsAbsolute>
  </PropertyGroup>

  <UsingTask TaskName="ValidateLicenseProductionTrust"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Linq;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class ValidateLicenseProductionTrust : Task
{
    [Required] public string ServiceUrl { get; set; } = string.Empty;
    [Required] public string SigningPublicKey { get; set; } = string.Empty;
    [Required] public string CurrentSpkiPin { get; set; } = string.Empty;
    [Required] public string NextSpkiPin { get; set; } = string.Empty;

    public override bool Execute()
    {
        try
        {
            var validUrl = Uri.TryCreate(ServiceUrl, UriKind.Absolute, out var endpoint)
                && string.Equals(endpoint.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
                && string.Equals(endpoint.AbsoluteUri, "https://ota.fanfh.cn/", StringComparison.Ordinal)
                && !string.IsNullOrWhiteSpace(endpoint.Host)
                && string.IsNullOrEmpty(endpoint.UserInfo)
                && string.IsNullOrEmpty(endpoint.Query)
                && string.IsNullOrEmpty(endpoint.Fragment)
                && endpoint.Port is >= 1 and <= 65535;
            var validPinPair = IsPin(CurrentSpkiPin)
                && IsPin(NextSpkiPin)
                && !string.Equals(CurrentSpkiPin, NextSpkiPin, StringComparison.Ordinal);
            var encodedKey = Convert.FromBase64String(SigningPublicKey);
            var p256SpkiPrefix = new byte[]
            {
                0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48,
                0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a, 0x86, 0x48,
                0xce, 0x3d, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04,
            };
            var validKey = encodedKey.Length == 91
                && encodedKey.Take(p256SpkiPrefix.Length).SequenceEqual(p256SpkiPrefix)
                && TryImportP256Point(encodedKey, p256SpkiPrefix.Length);
            if (validUrl && validPinPair && validKey)
                return true;
        }
        catch
        {
        }
        Log.LogError("License production trust configuration is invalid.");
        return false;
    }

    private static bool IsPin(string value) => value is { Length: 64 }
        && value.All(character => character is >= '0' and <= '9' or >= 'a' and <= 'f');

    private static bool TryImportP256Point(byte[] subjectPublicKeyInfo, int pointOffset)
    {
        var blob = new byte[72];
        blob[0] = 0x45; blob[1] = 0x43; blob[2] = 0x53; blob[3] = 0x31;
        blob[4] = 0x20;
        Buffer.BlockCopy(subjectPublicKeyInfo, pointOffset, blob, 8, 64);
        IntPtr algorithm = IntPtr.Zero;
        IntPtr key = IntPtr.Zero;
        try
        {
            if (BCryptOpenAlgorithmProvider(out algorithm, "ECDSA_P256", null, 0) != 0)
                return false;
            return BCryptImportKeyPair(
                algorithm, IntPtr.Zero, "ECCPUBLICBLOB", out key, blob, blob.Length, 0) == 0;
        }
        finally
        {
            if (key != IntPtr.Zero) BCryptDestroyKey(key);
            if (algorithm != IntPtr.Zero) BCryptCloseAlgorithmProvider(algorithm, 0);
        }
    }

    [DllImport("bcrypt.dll", CharSet = CharSet.Unicode)]
    private static extern int BCryptOpenAlgorithmProvider(
        out IntPtr algorithm,
        string algorithmId,
        string implementation,
        int flags);

    [DllImport("bcrypt.dll", CharSet = CharSet.Unicode)]
    private static extern int BCryptImportKeyPair(
        IntPtr algorithm,
        IntPtr importKey,
        string blobType,
        out IntPtr key,
        byte[] input,
        int inputLength,
        int flags);

    [DllImport("bcrypt.dll")]
    private static extern int BCryptDestroyKey(IntPtr key);

    [DllImport("bcrypt.dll")]
    private static extern int BCryptCloseAlgorithmProvider(IntPtr algorithm, int flags);
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Import Project="..\..\eng\license\ProductionLicenseTrust.targets" />

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="$(ProductBrandingPngPath)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperPan.Licensing.Client\SuperPan.Licensing.Client.csproj" />
    <ProjectReference Include="..\BaiduBatchTransfer.Core\BaiduBatchTransfer.Core.csproj" />
    <ProjectReference Include="..\BaiduBatchTransfer.Application\BaiduBatchTransfer.Application.csproj" />
    <ProjectReference Include="..\BaiduBatchTransfer.Infrastructure\BaiduBatchTransfer.Infrastructure.csproj" />
    <ProjectReference Include="..\BaiduBatchTransfer.BaiduAdapter\BaiduBatchTransfer.BaiduAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateFeedUrl</_Parameter1>
      <_Parameter2>$(UpdateFeedUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateChannel</_Parameter1>
      <_Parameter2>$(UpdateChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AdapterBuildVersion</_Parameter1>
      <_Parameter2>$(AdapterBuildVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OtaAcceptanceBuild</_Parameter1>
      <_Parameter2>$(OtaAcceptanceBuild)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OtaAcceptanceFeedPath</_Parameter1>
      <_Parameter2>$(OtaAcceptanceFeedPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseProductId</_Parameter1>
      <_Parameter2>$(LicenseProductId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseRuntimeMode</_Parameter1>
      <_Parameter2>$(LicenseRuntimeMode)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseServiceUrl</_Parameter1>
      <_Parameter2>$(LicenseServiceUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseSigningPublicKey</_Parameter1>
      <_Parameter2>$(LicenseSigningPublicKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseSigningKeyId</_Parameter1>
      <_Parameter2>$(LicenseSigningKeyId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseCurrentSpkiPin</_Parameter1>
      <_Parameter2>$(LicenseCurrentSpkiPin)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseNextSpkiPin</_Parameter1>
      <_Parameter2>$(LicenseNextSpkiPin)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LicenseAcceptanceBuild</_Parameter1>
      <_Parameter2>$(LicenseAcceptanceBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\..\tools\managed_browser_helper\helper-manifest.json"
                      LogicalName="BaiduBatchTransfer.ManagedBrowserHelper.helper-manifest.json" />
    <Content Include="$(ManagedBrowserHelperPackageDirectory)\**\*"
             Condition="Exists('$(ManagedBrowserHelperPackageDirectory)\helper-manifest.json')"
             Link="managed-browser-helper\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\tools\collect_helper\**\*.py"
             Exclude="$(MSBuildProjectDirectory)\..\..\tools\collect_helper\tests\**\*.py;$(MSBuildProjectDirectory)\..\..\tools\collect_helper\demo.py;$(MSBuildProjectDirectory)\..\..\tools\collect_helper\**\__pycache__\**\*.py"
             Link="collect-helper\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateManagedBrowserHelperReleasePackage"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(ManagedBrowserHelperPackageDirectory)\helper-manifest.json')"
           Text="A Release build requires a deterministic managed-browser-helper package. Run scripts/build_managed_browser_helper.ps1 and set ManagedBrowserHelperPackageDirectory if needed." />
    <Exec Condition="Exists('$(ManagedBrowserHelperPackageDirectory)\helper-manifest.json')"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\verify_managed_browser_helper_package.ps1&quot; -ManifestSource &quot;$(MSBuildProjectDirectory)\..\..\tools\managed_browser_helper\helper-manifest.json&quot; -PackageDirectory &quot;$(ManagedBrowserHelperPackageDirectory)&quot; -HelperSourceDirectory &quot;$(MSBuildProjectDirectory)\..\..\tools\managed_browser_helper&quot;" />
  </Target>

  <Target Name="ValidateOtaBuildConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(_VersionPrefixIsValid)' != 'True'"
           Text="OTA product version must contain three canonical numeric parts between 0 and 65534." />
    <Error Condition="'$(Version)' != '$(_ExpectedProductVersion)'"
           Text="OTA Version must be derived from VersionPrefix." />
    <Error Condition="'$(InformationalVersion)' != '$(_ExpectedInformationalVersion)'"
           Text="OTA InformationalVersion must be derived from VersionPrefix." />
    <Error Condition="'$(FileVersion)' != '$(_ExpectedFileVersion)'"
           Text="OTA FileVersion must be derived from VersionPrefix." />
    <Error Condition="'$(AssemblyVersion)' != '$(_ExpectedAssemblyVersion)'"
           Text="OTA AssemblyVersion must be derived from VersionPrefix." />
    <Error Condition="'$(OtaAcceptanceBuild)' != 'true' and '$(OtaAcceptanceBuild)' != 'false'"
           Text="OTA acceptance build flag must be true or false." />
    <Error Condition="'$(UpdateFeedUrl)' != '' and '$(OtaAcceptanceFeedPath)' != ''"
           Text="OTA production and acceptance feeds cannot both be configured." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'true' and '$(UpdateFeedUrl)' != ''"
           Text="OTA acceptance builds cannot use a production feed URL." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'true' and '$(_AcceptanceFeedIsAbsolute)' != 'True'"
           Text="OTA acceptance builds require an absolute local feed path." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'true' and '$(PackageId)' != 'SuperPan.BaiduBatchTransfer.OtaAcceptance'"
           Text="OTA acceptance builds require the dedicated acceptance package ID." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'true' and '$(UpdateChannel)' != 'win-x64-ota-acceptance'"
           Text="OTA acceptance builds require the dedicated acceptance channel." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'false' and '$(OtaAcceptanceFeedPath)' != ''"
           Text="OTA production builds cannot use a local feed path." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'false' and '$(PackageId)' != 'SuperPan.BaiduBatchTransfer'"
           Text="OTA production builds require the dedicated production package ID." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'false' and '$(UpdateFeedUrl)' != '' and '$(_UpdateFeedUrlIsValid)' != 'True'"
           Text="OTA production feed must be an absolute HTTPS URL without credentials, query, or fragment." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'false' and '$(UpdateFeedUrl)' != '' and '$(_UpdateFeedUrlIsApprovedProduction)' != 'True'"
           Text="OTA production feed must be the exact approved production URL." />
    <Error Condition="'$(OtaAcceptanceBuild)' == 'false' and '$(UpdateChannel)' != 'win-x64-stable'"
           Text="OTA production builds require the win-x64-stable channel." />
  </Target>

  <Target Name="ValidateLicenseBuildConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LicenseAcceptanceBuild)' != 'true' and '$(LicenseAcceptanceBuild)' != 'false'"
           Text="License acceptance build flag must be true or false." />
    <Error Condition="'$(Configuration)' == 'Release' and '$(LicenseAcceptanceBuild)' == 'true'"
           Text="License Release builds cannot carry the acceptance stamp." />
    <ValidateLicenseProductionTrust Condition="'$(LicenseRuntimeMode)' == 'Production'"
                                    ServiceUrl="$(LicenseServiceUrl)"
                                    SigningPublicKey="$(LicenseSigningPublicKey)"
                                    CurrentSpkiPin="$(LicenseCurrentSpkiPin)"
                                    NextSpkiPin="$(LicenseNextSpkiPin)" />
    <ValidateExactProductionLicenseTrust Condition="'$(LicenseRuntimeMode)' == 'Production'"
                                           ServiceUrl="$(LicenseServiceUrl)"
                                           ProductId="$(LicenseProductId)"
                                           ExpectedProductId="8270e8d7-1791-487d-ad76-0da7a0cbed12"
                                           SigningKeyId="$(LicenseSigningKeyId)"
                                           SigningPublicKey="$(LicenseSigningPublicKey)"
                                           CurrentSpkiPin="$(LicenseCurrentSpkiPin)"
                                           NextSpkiPin="$(LicenseNextSpkiPin)" />
    <Error Condition="'$(LicenseRuntimeMode)' == 'Acceptance' and '$(_LicenseAcceptanceConfigIsAbsolute)' != 'True'"
           Text="License acceptance builds require an absolute local configuration path." />
    <Error Condition="'$(LicenseRuntimeMode)' == 'Acceptance' and '$(_LicenseServiceUrlIsAcceptanceLoopback)' != 'True'"
           Text="License acceptance builds allow only the literal HTTP loopback service URL." />
  </Target>

</Project>

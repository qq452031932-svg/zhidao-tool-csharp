<Window x:Class="BaiduBatchTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="知道综合工具" Icon="{DynamicResource ProductWindowIcon}"
        Height="820" Width="1280" MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="CustomTitleBar"
                Grid.Row="0"
                Height="36"
                Background="{StaticResource TitleBarBrush}"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding ApplicationTitle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Width="46" Height="36" MinHeight="0" Margin="0" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Content="—"
                            AutomationProperties.Name="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeRestoreButton"
                            Width="46" Height="36" MinHeight="0" Margin="0" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Content="□"
                            AutomationProperties.Name="最大化或还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeRestoreClick" />
                    <Button x:Name="CloseButton"
                            Width="46" Height="36" MinHeight="0" Margin="0" Padding="0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Content="×" FontSize="18"
                            AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ProductHeader"
                Grid.Row="1"
                Height="64"
                Background="White"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ApplicationTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="百度网盘批量管理工作台" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                    <Border x:Name="LicenseSummaryPanel"
                            Margin="18,0,0,0"
                            Padding="9,5"
                            VerticalAlignment="Center"
                            Background="{StaticResource PageBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LicensePackageDisplay, StringFormat=授权：{0}}"
                                       Foreground="#52677B"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <Border Width="1" Height="12" Margin="8,0"
                                    Background="{StaticResource PanelBorderBrush}" />
                            <TextBlock Text="{Binding LicenseExpiryDisplay, StringFormat=到期：{0}}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="CurrentWorkspaceBadge"
                            Background="{StaticResource NavSelectedBrush}"
                            BorderBrush="#B9DDF5"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,5">
                        <TextBlock Text="{Binding CurrentWorkspaceTitle, StringFormat=当前模块：{0}}"
                                   Foreground="{StaticResource BrandBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="OperationStatusLiveRegion"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               AutomationProperties.Name="{Binding StatusMessage}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ShellBody" Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AccountRail" Grid.Column="0"
                    Style="{StaticResource BorderedPanelStyle}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="添加百度账号" Command="{Binding OpenAccountLoginCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="账号管理" Command="{Binding OpenAccountManagementCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0" Padding="8,4" />
                            <Button Grid.Column="2" Content="刷新账号" Command="{Binding RefreshAccountsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0" Padding="8,4"
                                    AutomationProperties.Name="刷新百度账号列表" />
                        </Grid>
                        <TextBlock Text="{Binding AccountManagementStatusMessage}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="{Binding AccountManagementStatusMessage}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="账号管理" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="百度网盘账号" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,3,0,0" />
                        <Border Background="{StaticResource PageBrush}" CornerRadius="4"
                                Padding="8,5" Margin="0,10,0,0">
                            <TextBlock x:Name="AccountStatusLiveRegion"
                                       Text="{Binding AccountStatusMessage}"
                                       Foreground="#52677B"
                                       FontSize="12"
                                       AutomationProperties.Name="{Binding AccountStatusMessage}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton x:Name="AccountCard"
                                                  MinHeight="96"
                                                  Margin="0,0,0,10"
                                                  Padding="10"
                                                  Focusable="True"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding DisplayName, StringFormat=选择账号：{0}}"
                                                  AutomationProperties.HelpText="按空格键切换账号选择状态">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="CardBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.BatchTransferWorkspace.DataContext.CanEditConfiguration, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                                                 Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" VerticalAlignment="Top">
                                                <Ellipse Fill="#45A6D9" />
                                                <TextBlock Text="盘" Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUri}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="AccountStatusPill"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource PageBrush}"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{StaticResource BrandBrush}"
                                                               FontSize="11" />
                                                </Border>
                                                <TextBlock Text="{Binding CapacitySummaryText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="FeatureRail" Grid.Column="2"
                    Style="{StaticResource BorderedPanelStyle}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="功能导航" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="选择一个工作模块" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="FeatureMenu" Grid.Row="1"
                                VerticalAlignment="Top" Margin="0,24,0,0">
                        <Button Content="首页" Command="{Binding ShowHomeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="首页">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="分享数据" Command="{Binding ShowShareDataCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="分享数据">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="批量转存" Command="{Binding ShowBatchTransferCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="批量转存">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="广告插入" Command="{Binding ShowAdInsertionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="广告插入">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="文件排除" Command="{Binding ShowFileExclusionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="文件排除">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="数据统计" Command="{Binding ShowStatisticsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="数据统计">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="设置中心" Command="{Binding ShowSettingsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentWorkspaceTitle}" Value="设置中心">
                                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="ContentWorkbench" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentWorkspaceTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
            </Grid>
        </Grid>
    </Grid>
</Window>

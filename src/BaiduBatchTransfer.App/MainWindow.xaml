<Window x:Class="BaiduBatchTransfer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="百度批量转存" Height="820" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApplicationTitle}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="仅支持百度网盘 · 批量任务由本机安全调度" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" KeyboardNavigation.TabNavigation="Local">
                        <Button Content="添加百度账号" Command="{Binding OpenAccountLoginCommand}"
                                TabIndex="0" MinWidth="118" />
                        <Button Content="账号管理" Command="{Binding OpenAccountManagementCommand}"
                                TabIndex="1" MinWidth="96" Margin="8,0,0,0" />
                        <Button Content="刷新账号" Command="{Binding RefreshAccountsCommand}"
                                AutomationProperties.Name="刷新百度账号列表"
                                TabIndex="2" MinWidth="96" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock Text="{Binding AccountStatusMessage}" Foreground="#52677B" FontSize="12"
                                   AutomationProperties.Name="当前百度账号数量"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text=" · " Foreground="#8A9BAB" FontSize="12" />
                        <TextBlock Text="{Binding AccountManagementStatusMessage}" Foreground="#52677B" FontSize="12"
                                   AutomationProperties.Name="账号管理状态"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#102A43" Padding="14,20">
                <StackPanel>
                    <TextBlock Text="工作区" Foreground="#AFC6DB" Margin="8,0,0,10" />
                    <Button Content="导入与草稿" Command="{Binding ShowImportCommand}" HorizontalContentAlignment="Left" />
                    <Button Content="创建任务" Command="{Binding ShowCreateJobCommand}" HorizontalContentAlignment="Left" Margin="0,8,8,0" />
                    <Border Background="#183B56" CornerRadius="8" Padding="10" Margin="0,24,0,0">
                        <TextBlock Text="{Binding AdapterStatusMessage}" TextWrapping="Wrap" Foreground="#D7E8F7" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</Window>
